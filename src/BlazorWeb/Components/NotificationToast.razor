@inject NotificationHubService Hub
@implements IDisposable

@if (_toasts.Count > 0)
{
    <div class="fixed bottom-6 right-6 z-50 flex flex-col gap-3 max-w-sm" style="pointer-events:none;">
        @foreach (var t in _toasts)
        {
            <div class="flex items-start gap-3 px-4 py-3.5 rounded-2xl shadow-xl text-sm font-medium transition-all
                        @ToastBg(t.Type)" style="pointer-events:auto;">
                <span class="text-lg leading-none mt-0.5 shrink-0">@ToastIcon(t.Type)</span>
                <div>
                    <p class="font-semibold">@t.Title</p>
                    @if (t.Body is not null)
                    {
                        <p class="text-xs opacity-80 mt-0.5">@t.Body</p>
                    }
                </div>
            </div>
        }
    </div>
}

@code {
    private readonly List<ToastItem> _toasts = [];

    // Named handlers, not lambdas. Dispose() used to "unsubscribe" by writing
    // -= p => Push(...), which allocates a BRAND NEW delegate every time -- it
    // never matches the one that was added, so nothing was ever removed and
    // every navigation left another live subscription behind, each one firing
    // its own duplicate toast.
    private void OnAssignmentInvite(NotificationPayload p)   => Push("📩 New Event Invite", $"{p.VendorName} invited you to {p.EventTitle}", ToastType.Info);
    private void OnCrewAccepted(NotificationPayload p)       => Push("✅ Crew Accepted", $"{p.CrewName} accepted the assignment.", ToastType.Success);
    private void OnCrewDeclined(NotificationPayload p)       => Push("❌ Crew Declined", $"{p.CrewName} declined. {p.Reason}", ToastType.Warning);
    private void OnVendorApproved(NotificationPayload p)     => Push("✅ Vendor Approved You", "Your assignment was approved by the vendor!", ToastType.Success);
    private void OnVendorRejected(NotificationPayload p)     => Push("❌ Vendor Rejected", $"Reason: {p.Reason ?? "No reason given."}", ToastType.Error);
    private void OnPendingManagerApproval(NotificationPayload p) => Push("📋 Approval Needed", $"{p.CrewName} is pending your approval.", ToastType.Info);
    private void OnManagerApproved(NotificationPayload p)    => Push("🎉 Manager Approved!", "Your assignment is fully approved. Get ready!", ToastType.Success);
    private void OnManagerRejected(NotificationPayload p)    => Push("❌ Manager Rejected", $"Reason: {p.Reason ?? "No reason given."}", ToastType.Error);
    private void OnSystem(string m)                          => Push("📢 System", m, ToastType.Info);

    // New self-registration in the approval queue -- the notification that was
    // missing entirely: the server never pushed it and nothing listened.
    private void OnRegistrationSubmitted(NotificationPayload p) => Push(
        "🆕 New Registration",
        $"{p.PersonName ?? "Someone"} registered as {p.Role ?? "a user"}"
            + (string.IsNullOrWhiteSpace(p.BusinessName) ? "" : $" ({p.BusinessName})")
            + " and is pending approval.",
        ToastType.Info);

    // The admin decision on your own registration.
    private void OnRegistrationDecision(NotificationPayload p) => Push(
        string.IsNullOrWhiteSpace(p.Reason) ? "✅ Registration Approved" : "❌ Registration Rejected",
        string.IsNullOrWhiteSpace(p.Reason) ? "Your account is active -- you can sign in now." : $"Reason: {p.Reason}",
        string.IsNullOrWhiteSpace(p.Reason) ? ToastType.Success : ToastType.Error);

    // Vendor invited to an event / re-invited / invite revoked.
    private void OnAssignmentChanged(NotificationPayload p) => Push(
        "🗓️ Assignment Updated",
        string.IsNullOrWhiteSpace(p.EventTitle) ? "Your event assignments changed." : $"Change on {p.EventTitle}.",
        ToastType.Info);

    // ─── Notification platform feed ─────────────────────────────────────────
    // Codes whose legacy push ALREADY raises a toast. While both paths run in
    // parallel, the platform feed stays quiet for these -- otherwise one crew
    // assignment produces two identical toasts, which reads as a bug and is a worse
    // regression than the duplication it comes from.
    //
    // VERIFIED against the actual toast subscriptions below, one code at a time,
    // rather than against the list of legacy push names. Four codes were removed
    // after that check: PAYMENT_APPROVED, PAYMENT_REJECTED, PAYROLL_RELEASED and
    // CHECK_IN_VERIFIED. Their legacy pushes exist, but they fold into
    // PaymentChangedReceived / CheckInVerifiedReceived, which only REFETCH tables
    // and open modals -- no toast is raised. Suppressing them here produced silence,
    // not de-duplication: a crew member would have been told nothing when their
    // payment was approved. EVENT_ANNOUNCEMENT went for the same reason; nothing
    // toasts EventAnnouncementReceived, only the sidebar badge listens.
    //
    // The lesson, for whoever edits this next: a legacy push existing is NOT
    // evidence that a toast exists. Check the subscription, not the push.
    //
    // Each remaining entry is deleted as its legacy push is retired, so the feed
    // takes over one notification type at a time and this set shrinks to empty.
    private static readonly HashSet<string> LegacyToastedCodes = new(StringComparer.OrdinalIgnoreCase)
    {
        "CREW_ASSIGNMENT",           // OnAssignmentInvite
        "CREW_INVITATION",           // OnAssignmentInvite (vendor-initiated invites)
        "CREW_ASSIGNMENT_APPROVED",  // OnVendorApproved / OnManagerApproved
        "CREW_ASSIGNMENT_REJECTED",  // OnVendorRejected / OnManagerRejected
        "ACCOUNT_APPROVED",          // OnRegistrationDecision
        "ACCOUNT_REJECTED",          // OnRegistrationDecision
        "VENDOR_EVENT_INVITED",      // OnAssignmentChanged
        "CREW_INVITE_REVOKED",       // OnAssignmentChanged
        "VENDOR_INVITE_REVOKED",     // OnAssignmentChanged
        "REGISTRATION_PENDING_APPROVAL", // OnRegistrationSubmitted
        "ASSIGNMENT_PENDING_APPROVAL",   // OnPendingManagerApproval
        "CREW_ACCEPTED_ASSIGNMENT",      // OnCrewAccepted
        "CREW_DECLINED_ASSIGNMENT"       // OnCrewDeclined
        // CHECK_IN_VERIFIED is NOT listed: CheckInVerifiedReceived only refetches and
        // closes the QR modal, so suppressing it would remove the bell entry and put
        // nothing in its place.
        //
        // Note on the three AssignmentChanged codes above: their legacy toast is
        // generic ("Assignment Updated -- Change on Sunburn Arena"), while the platform
        // message actually says the invitation was withdrawn. Suppressing the better
        // message is the wrong way round, but the legacy handler is one subscription
        // shared by four server events -- including VendorEventAssigned, which is not
        // on the platform yet -- so it cannot tell which fired. Retire the legacy
        // AssignmentChanged toast and drop all three codes from this list once the
        // event-creation paths are wired.
    };

    private void OnPlatformNotification(PlatformNotification n)
    {
        // Suppressed rather than skipped entirely: the notification is still
        // stored and still counts towards the unread badge. Only the toast is
        // withheld, because the legacy push is already showing one.
        if (n.Code is not null && LegacyToastedCodes.Contains(n.Code)) return;

        Push(
            n.Title ?? "Notification",
            Shorten(n.Body),
            n.IsUrgent ? ToastType.Warning : ToastType.Info);
    }

    /// <summary>
    /// Template bodies are written for email and WhatsApp, where length is fine.
    /// A toast is 380px wide, so an untrimmed body pushes the rest of the stack
    /// off screen.
    /// </summary>
    private static string? Shorten(string? body)
    {
        if (string.IsNullOrWhiteSpace(body)) return null;

        var flat = System.Text.RegularExpressions.Regex.Replace(body.Trim(), @"\s+", " ");

        return flat.Length <= 140 ? flat : flat[..137].TrimEnd() + "...";
    }

    protected override void OnInitialized()
    {
        Hub.AssignmentInviteReceived       += OnAssignmentInvite;
        Hub.CrewAcceptedReceived           += OnCrewAccepted;
        Hub.CrewDeclinedReceived           += OnCrewDeclined;
        Hub.VendorApprovedReceived         += OnVendorApproved;
        Hub.VendorRejectedReceived         += OnVendorRejected;
        Hub.PendingManagerApprovalReceived += OnPendingManagerApproval;
        Hub.ManagerApprovedReceived        += OnManagerApproved;
        Hub.ManagerRejectedReceived        += OnManagerRejected;
        Hub.SystemNotificationReceived     += OnSystem;
        Hub.RegistrationSubmittedReceived  += OnRegistrationSubmitted;
        Hub.RegistrationDecisionReceived   += OnRegistrationDecision;
        Hub.AssignmentChangedReceived      += OnAssignmentChanged;
        Hub.PlatformNotificationReceived   += OnPlatformNotification;
    }

    private void Push(string title, string? body, ToastType type)
    {
        var item = new ToastItem(Guid.NewGuid(), title, body, type);
        _toasts.Add(item);
        InvokeAsync(StateHasChanged);
        _ = Task.Delay(5000).ContinueWith(_ =>
        {
            _toasts.Remove(item);
            InvokeAsync(StateHasChanged);
        });
    }

    public void Dispose()
    {
        Hub.AssignmentInviteReceived       -= OnAssignmentInvite;
        Hub.CrewAcceptedReceived           -= OnCrewAccepted;
        Hub.CrewDeclinedReceived           -= OnCrewDeclined;
        Hub.VendorApprovedReceived         -= OnVendorApproved;
        Hub.VendorRejectedReceived         -= OnVendorRejected;
        Hub.PendingManagerApprovalReceived -= OnPendingManagerApproval;
        Hub.ManagerApprovedReceived        -= OnManagerApproved;
        Hub.ManagerRejectedReceived        -= OnManagerRejected;
        Hub.SystemNotificationReceived     -= OnSystem;
        Hub.RegistrationSubmittedReceived  -= OnRegistrationSubmitted;
        Hub.RegistrationDecisionReceived   -= OnRegistrationDecision;
        Hub.AssignmentChangedReceived      -= OnAssignmentChanged;
        Hub.PlatformNotificationReceived   -= OnPlatformNotification;
    }

    private static string ToastBg(ToastType t) => t switch
    {
        ToastType.Success => "bg-green-600  text-white",
        ToastType.Warning => "bg-amber-500  text-white",
        ToastType.Error   => "bg-red-600    text-white",
        _                 => "bg-gray-800   text-white",
    };

    private static string ToastIcon(ToastType t) => t switch
    {
        ToastType.Success => "✅",
        ToastType.Warning => "⚠️",
        ToastType.Error   => "❌",
        _                 => "ℹ️",
    };

    private enum ToastType { Info, Success, Warning, Error }
    private sealed record ToastItem(Guid Id, string Title, string? Body, ToastType Type);
}
