@*
    The OpsOracle mark, inline rather than an <img>: it has to sit in a sidebar, a
    login card and a hero at different sizes, inherit crisp edges at 20px, and be
    styleable from the call site. An <img> would cost a request and blur when scaled.
*@

<svg viewBox="0 0 64 64" class="@Class" width="@Size" height="@Size"
     role="img" aria-label="OpsOracle" xmlns="http://www.w3.org/2000/svg">
    <defs>
        @* Unique gradient id per instance -- two inline SVGs sharing one id means the
           second silently reuses the first's gradient, and it breaks the moment a page
           renders the mark twice. *@
        <linearGradient id="@_gid" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0"    stop-color="#4f46e5" />
            <stop offset="0.55" stop-color="#8b5cf6" />
            <stop offset="1"    stop-color="#d946ef" />
        </linearGradient>
    </defs>
    <rect width="64" height="64" rx="15.4" fill="@(Flat ? "none" : $"url(#{_gid})")" />
    <path d="M32.68 47.67 A 15.68 15.68 0 1 1 47.67 32.68"
          fill="none" stroke="@Ink" stroke-width="5.44" stroke-linecap="round" />
    <circle cx="32" cy="32" r="5.44" fill="@Ink" />
</svg>

@code {
    [Parameter] public int Size { get; set; } = 40;
    [Parameter] public string Class { get; set; } = "";

    /// <summary>Drop the gradient tile and draw the glyph alone (for coloured surfaces).</summary>
    [Parameter] public bool Flat { get; set; }

    /// <summary>Glyph colour. White reads on the gradient tile; override when Flat.</summary>
    [Parameter] public string Ink { get; set; } = "#ffffff";

    private readonly string _gid = $"oo-{Guid.NewGuid():N}";
}
