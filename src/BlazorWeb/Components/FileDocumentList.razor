@inject IFilesApiService FilesApi
@inject IJSRuntime JS

@*
    Shared "uploaded documents" list — preview (images) + download, with a
    thumbnail once loaded. Extracted from ApprovalQueue.razor's "View
    details" modal so Crew.razor and Vendors.razor's own "View details"
    modals show identical document handling instead of re-implementing it.
*@

@if (Files is { Count: > 0 })
{
    <div class="mt-4 pt-4 border-t border-gray-100">
        <p class="text-xs font-semibold text-gray-500 mb-2">@Title</p>
        <div class="space-y-2">
            @foreach (var f in Files)
            {
                <div class="flex items-center gap-3 bg-gray-50 rounded-xl p-2.5">
                    @if (_previewDataUrls.TryGetValue(f.Id, out var dataUrl))
                    {
                        <img src="@dataUrl" class="w-12 h-12 rounded-lg object-cover flex-shrink-0 border border-gray-200" />
                    }
                    else
                    {
                        <div class="w-12 h-12 rounded-lg bg-gray-100 flex items-center justify-center text-lg flex-shrink-0">📄</div>
                    }
                    <div class="flex-1 min-w-0">
                        <div class="text-xs font-medium text-gray-800">@DocumentTypes.Label(f.DocumentType)</div>
                        <div class="text-[11px] text-gray-500 truncate">@f.OriginalFileName · @HumanSize(f.FileSizeBytes)</div>
                        @if (_previewErrors.TryGetValue(f.Id, out var rowErr))
                        {
                            <div class="text-[11px] text-red-600 truncate">@rowErr</div>
                        }
                    </div>
                    @if (f.ContentType.StartsWith("image/") && !_previewDataUrls.ContainsKey(f.Id) && !_previewErrors.ContainsKey(f.Id))
                    {
                        <button type="button" @onclick="() => LoadPreviewAsync(f.Id, f.ContentType)"
                                disabled="@_previewLoadingIds.Contains(f.Id)"
                                class="text-xs text-indigo-600 hover:underline flex-shrink-0 disabled:opacity-50">
                            @(_previewLoadingIds.Contains(f.Id) ? "Loading…" : "Preview")
                        </button>
                    }
                    <button type="button" @onclick="() => DownloadFileAsync(f)"
                            disabled="@_downloadingIds.Contains(f.Id)"
                            class="text-xs text-indigo-600 hover:underline flex-shrink-0 disabled:opacity-50">
                        @(_downloadingIds.Contains(f.Id) ? "…" : "⬇ Download")
                    </button>
                </div>
            }
        </div>
        @if (_error is not null)
        {
            <p class="text-[11px] text-red-600 mt-1.5">@_error</p>
        }
    </div>
}

@code {
    [Parameter] public IReadOnlyList<FileDocumentDto>? Files { get; set; }
    [Parameter] public string Title { get; set; } = "Uploaded documents";

    private readonly Dictionary<Guid, string> _previewDataUrls = new();
    private readonly HashSet<Guid> _previewLoadingIds = new();
    private readonly HashSet<Guid> _downloadingIds = new();
    private string? _error;

    // Files whose bytes the server could not produce. Tracked so the button
    // stops inviting a retry that will fail the same way, and so the row says
    // WHY -- a preview that silently does nothing reads as a broken button.
    private readonly Dictionary<Guid, string> _previewErrors = new();

    private async Task LoadPreviewAsync(Guid fileId, string contentType)
    {
        _previewLoadingIds.Add(fileId);
        _previewErrors.Remove(fileId);
        _error = null;
        StateHasChanged();
        try
        {
            var (ok, content, respContentType, error) = await FilesApi.DownloadAsync(fileId);
            if (ok && content is not null)
            {
                var mime = respContentType ?? contentType;
                _previewDataUrls[fileId] = $"data:{mime};base64,{Convert.ToBase64String(content)}";
            }
            else
            {
                _previewErrors[fileId] = error ?? "Preview failed.";
                _error = error ?? "Preview failed.";
            }
        }
        finally
        {
            _previewLoadingIds.Remove(fileId);
            StateHasChanged();
        }
    }

    private async Task DownloadFileAsync(FileDocumentDto f)
    {
        _downloadingIds.Add(f.Id);
        _error = null;
        try
        {
            var (ok, content, contentType, error) = await FilesApi.DownloadAsync(f.Id);
            if (ok && content is not null)
            {
                await JS.InvokeVoidAsync("downloadFileFromBytes", f.OriginalFileName,
                    contentType ?? f.ContentType, Convert.ToBase64String(content));
            }
            else
            {
                _error = error ?? "Download failed.";
            }
        }
        finally
        {
            _downloadingIds.Remove(f.Id);
            StateHasChanged();
        }
    }

    // NOT a switch expression with relational patterns ("< 1024 => ...") on
    // purpose — see ApprovalQueue.razor's identical helper for why.
    private static string HumanSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:0.#} KB";
        return $"{bytes / (1024.0 * 1024.0):0.#} MB";
    }
}
