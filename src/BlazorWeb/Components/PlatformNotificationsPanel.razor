@inject INotificationApiService Api
@inject NotificationHubService Hub
@implements IDisposable

@*
    The persistent view of the notification platform's in-app channel: assignment
    invites, cancellations, payment decisions. Separate from
    EventNotificationsPanel, which shows admin-composed announcements -- these are
    generated by business events and arrive across email and WhatsApp too, so this
    is the app's copy of that same trail.
*@

<div class="space-y-3">
    <div class="flex items-center justify-between gap-3">
        <div>
            <h3 class="text-sm font-bold text-gray-800">Activity</h3>
            <p class="text-xs text-gray-500">
                Assignments, event changes and payment updates.
            </p>
        </div>

        @if (_page.UnreadCount > 0)
        {
            <button class="text-xs font-semibold text-indigo-600 hover:text-indigo-800 disabled:opacity-50 shrink-0"
                    disabled="@_busy" @onclick="MarkAllRead">
                Mark all read (@_page.UnreadCount)
            </button>
        }
    </div>

    @if (_loading)
    {
        <div class="py-8 text-center text-sm text-gray-400">Loading…</div>
    }
    else if (_page.Items.Count == 0)
    {
        <div class="py-8 text-center">
            <p class="text-sm text-gray-500">Nothing here yet.</p>
            <p class="text-xs text-gray-400 mt-1">
                You'll see assignment invites and event changes as they happen.
            </p>
        </div>
    }
    else
    {
        <ul class="divide-y divide-gray-100">
            @foreach (var n in _page.Items)
            {
                <li class="py-3 flex items-start gap-3 @(n.IsRead ? "" : "bg-indigo-50/40 -mx-2 px-2 rounded-lg")">
                    @* Unread marker is a dot rather than bold text: a list of all-bold
                       rows is harder to scan than a column of quiet dots. *@
                    <span class="mt-1.5 w-2 h-2 rounded-full shrink-0
                                 @(n.IsRead ? "bg-transparent" : n.IsUrgent ? "bg-red-500" : "bg-indigo-500")"></span>

                    <div class="min-w-0 flex-1">
                        <div class="flex items-baseline justify-between gap-2">
                            <p class="text-sm font-semibold text-gray-800 truncate">
                                @(string.IsNullOrWhiteSpace(n.Title) ? Humanise(n.Code) : n.Title)
                            </p>
                            <span class="text-[11px] text-gray-400 shrink-0">@n.Age</span>
                        </div>

                        <p class="text-xs text-gray-600 mt-0.5 whitespace-pre-line">@n.Body</p>
                    </div>

                    @if (!n.IsRead)
                    {
                        <button class="text-[11px] font-semibold text-gray-400 hover:text-indigo-600 shrink-0 mt-0.5"
                                title="Mark read" disabled="@_busy" @onclick="() => MarkRead(n.Id)">
                            ✓
                        </button>
                    }
                </li>
            }
        </ul>

        @if (_page.Items.Count < _page.Total)
        {
            <button class="w-full text-xs font-semibold text-gray-500 hover:text-indigo-600 py-2"
                    disabled="@_busy" @onclick="LoadMore">
                Show older (@(_page.Total - _page.Items.Count) more)
            </button>
        }
    }
</div>

@code {
    private InboxPageDto _page = new(new List<InboxNotificationDto>(), 0, 0);
    private bool _loading = true;
    private bool _busy;

    private const int PageSize = 20;

    /// <summary>Raised whenever the unread count changes, so the sidebar badge can follow.</summary>
    [Parameter] public EventCallback<int> UnreadCountChanged { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // Named handler, not a lambda: Dispose() must be able to remove the exact
        // delegate it added, or every navigation leaves another live subscription
        // behind and the list gains a duplicate row per visit.
        Hub.PlatformNotificationReceived += OnLiveNotification;

        await Reload();
    }

    private void OnLiveNotification(PlatformNotification incoming)
    {
        // Refetched rather than inserting the pushed payload: the server is the
        // authority on ordering, read state and the rendered wording, and a locally
        // constructed row would drift from it. The push is just the trigger.
        _ = InvokeAsync(async () =>
        {
            await Reload(keepPageSize: true);
            StateHasChanged();
        });
    }

    private async Task Reload(bool keepPageSize = false)
    {
        var take = keepPageSize ? Math.Max(_page.Items.Count, PageSize) : PageSize;

        _page    = await Api.MineAsync(take: take);
        _loading = false;

        await UnreadCountChanged.InvokeAsync(_page.UnreadCount);
    }

    private async Task LoadMore()
    {
        _busy = true;

        // Refetched from zero with a larger window rather than appending a second
        // page: a notification arriving between the two calls would otherwise shift
        // the offset and silently skip a row.
        _page = await Api.MineAsync(take: _page.Items.Count + PageSize);
        _busy = false;
    }

    private async Task MarkRead(Guid id)
    {
        _busy = true;

        if (await Api.MarkReadAsync(id))
            await Reload(keepPageSize: true);

        _busy = false;
    }

    private async Task MarkAllRead()
    {
        _busy = true;

        if (await Api.MarkAllReadAsync() > 0)
            await Reload(keepPageSize: true);

        _busy = false;
    }

    /// <summary>
    /// Fallback title for a notification whose template has since been removed:
    /// EVENT_CANCELLED reads as "Event cancelled" rather than shouting in snake case.
    /// </summary>
    private static string Humanise(string code)
    {
        if (string.IsNullOrWhiteSpace(code)) return "Notification";

        var words = code.Replace('_', ' ').ToLowerInvariant();
        return char.ToUpperInvariant(words[0]) + words[1..];
    }

    public void Dispose() => Hub.PlatformNotificationReceived -= OnLiveNotification;
}
