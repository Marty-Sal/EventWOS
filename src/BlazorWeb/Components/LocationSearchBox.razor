@using EventOpsOracle.BlazorWeb.Services
@implements IAsyncDisposable
@inject ILocationApiService LocationApi

@*
    Type-to-search venue picker.

    Debounced at 400 ms and it cancels the previous in-flight request, which is
    not just polish: the provider behind our API is rate-limited (~1 req/sec for
    the public Nominatim instance), so firing per keystroke would get us
    throttled and make search useless for everyone.

    The component surfaces suggestions and reports the chosen one upward. It
    never writes to the venue form itself — the parent decides what to do with a
    pick, which keeps this reusable for the event screen too.
*@

<div class="relative">
    <label class="block text-sm font-medium text-gray-700 mb-1">
        @Label
    </label>

    <div class="relative">
        <input type="text"
               class="w-full border border-gray-300 rounded-lg pl-9 pr-9 py-2 text-sm
                      focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
               placeholder="@Placeholder"
               value="@_query"
               @oninput="OnInput"
               @onfocus="() => _showResults = true"
               autocomplete="off" />

        <svg class="w-4 h-4 text-gray-400 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none"
             fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M21 21l-4.35-4.35M17 11a6 6 0 11-12 0 6 6 0 0112 0z" />
        </svg>

        @if (_searching)
        {
            <svg class="animate-spin w-4 h-4 text-indigo-500 absolute right-3 top-1/2 -translate-y-1/2"
                 fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor"
                      d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
            </svg>
        }
        else if (!string.IsNullOrEmpty(_query))
        {
            <button type="button" @onclick="Clear"
                    class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        }
    </div>

    @* Suggestion list. Rendered only when we actually have something to show,
       so an empty dropdown never covers the fields underneath. *@
    @if (_showResults && _results.Count > 0)
    {
        <ul class="absolute z-30 mt-1 w-full bg-white border border-gray-200 rounded-lg shadow-lg
                   max-h-64 overflow-y-auto">
            @foreach (var r in _results)
            {
                <li>
                    <button type="button"
                            @onclick="() => Select(r)"
                            class="w-full text-left px-3 py-2 hover:bg-indigo-50 border-b border-gray-100 last:border-0">
                        <div class="text-sm font-medium text-gray-900">@r.Name</div>
                        <div class="text-xs text-gray-500 truncate">@r.FullAddress</div>
                    </button>
                </li>
            }
        </ul>
    }
    else if (_showResults && _searched && !_searching && _results.Count == 0 && _query.Length >= MinChars)
    {
        <div class="absolute z-30 mt-1 w-full bg-white border border-gray-200 rounded-lg shadow-lg px-3 py-3">
            <p class="text-sm text-gray-600">No places found for “@_query”.</p>
            @* Search is assistive, not mandatory — say so, otherwise an admin
               with an unlisted venue thinks they're stuck. *@
            <p class="text-xs text-gray-400 mt-1">
                You can still type the address manually and drop the pin on the map.
            </p>
        </div>
    }
</div>

@code {
    [Parameter] public string Label       { get; set; } = "Search for a place";
    [Parameter] public string Placeholder { get; set; } = "e.g. Millennium Business Park, Navi Mumbai";

    /// <summary>Raised when the admin picks a suggestion.</summary>
    [Parameter] public EventCallback<LocationSuggestion> OnSelected { get; set; }

    /// <summary>
    /// Matches the server's MinQueryLength. Kept as a parameter rather than a
    /// const so a caller can tighten it, but the server enforces its own floor
    /// regardless — this is a courtesy check to avoid pointless round trips.
    /// </summary>
    [Parameter] public int MinChars { get; set; } = 3;

    private string _query = string.Empty;
    private List<LocationSuggestion> _results = new();
    private bool _searching;
    private bool _searched;
    private bool _showResults;

    // One CTS per in-flight search. Cancelling it is what stops a slow earlier
    // response from overwriting the results of a newer query — the classic
    // out-of-order autocomplete bug.
    private CancellationTokenSource? _cts;

    private async Task OnInput(ChangeEventArgs e)
    {
        _query = e.Value?.ToString() ?? string.Empty;
        _showResults = true;

        _cts?.Cancel();
        _cts?.Dispose();
        _cts = null;

        if (_query.Trim().Length < MinChars)
        {
            _results.Clear();
            _searched = false;
            _searching = false;
            return;
        }

        var cts = new CancellationTokenSource();
        _cts = cts;
        var token = cts.Token;

        try
        {
            // The debounce itself. If another keystroke lands inside this window
            // the token is cancelled and we bail before making any request.
            await Task.Delay(400, token);

            _searching = true;
            StateHasChanged();

            var hits = await LocationApi.SearchAsync(_query, token);

            // Guard against a stale response: only the newest search may write
            // to the list.
            if (token.IsCancellationRequested || !ReferenceEquals(_cts, cts)) return;

            _results = hits.ToList();
            _searched = true;
        }
        catch (OperationCanceledException)
        {
            // Superseded by a newer keystroke — leave the existing suggestions
            // on screen rather than flashing them away.
            return;
        }
        finally
        {
            if (ReferenceEquals(_cts, cts))
            {
                _searching = false;
                StateHasChanged();
            }
        }
    }

    private async Task Select(LocationSuggestion s)
    {
        // Show the human-readable name in the box, hide the dropdown, and let the
        // parent apply the coordinates/address.
        _query = s.Name;
        _showResults = false;
        _results.Clear();
        await OnSelected.InvokeAsync(s);
    }

    private void Clear()
    {
        _cts?.Cancel();
        _query = string.Empty;
        _results.Clear();
        _searched = false;
        _showResults = false;
    }

    public ValueTask DisposeAsync()
    {
        // A pending Task.Delay holding a live component reference is a real leak
        // in a long-lived WASM session.
        _cts?.Cancel();
        _cts?.Dispose();
        _cts = null;
        return ValueTask.CompletedTask;
    }
}
