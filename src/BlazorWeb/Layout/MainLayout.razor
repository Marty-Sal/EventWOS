@inherits LayoutComponentBase
@using System.Net.Http.Json
@implements IDisposable
@inject NavigationManager Nav
@inject AppAuthStateProvider AuthState
@inject IAuthApiService AuthApi
@inject IUserApiService UserApi
@inject NotificationHubService Hub
@inject IEventApiService EventApi
@inject IAnnouncementApiService AnnouncementApi
@inject INotificationApiService NotificationApi
@inject HttpClient Http
@inject IJSRuntime JS

<div class="flex h-screen bg-gray-50 overflow-hidden">

    <!-- Mobile backdrop (only visible when the drawer is open on <md) -->
    @if (_sidebarOpen)
    {
        <div class="fixed inset-0 z-30 bg-black/50 md:hidden"
             @onclick="() => _sidebarOpen = false"></div>
    }

    <!--
        Sidebar
        On <md: fixed off-canvas drawer, slides in from the left when
                _sidebarOpen is true. z-40 to sit above the backdrop.
        On md+: normal in-flow flex sidebar (unchanged behaviour).
        The `transform` transition applies only on mobile — desktop
        rules override with `md:relative md:translate-x-0`.
    -->
    <aside class="@(_sidebarOpen ? "translate-x-0" : "-translate-x-full") md:translate-x-0
                  fixed inset-y-0 left-0 z-40 flex md:flex md:flex-shrink-0
                  md:relative md:inset-auto transition-transform duration-200 ease-in-out">
        <div class="flex flex-col w-64 bg-gray-900 text-white">
            <!-- Logo -->
            <div class="flex items-center h-16 px-6 border-b border-gray-700">
                <span class="text-xl font-bold tracking-tight text-white">⚡ EventWOS</span>
            </div>

            <!-- Nav Items -->
            <nav class="flex-1 px-4 py-6 space-y-1 overflow-y-auto" @onclick="() => _sidebarOpen = false">

            @if (_mustCompleteProfile)
            {
                <div class="px-3 py-3 mb-2 rounded-lg bg-amber-900/40 border border-amber-600/50">
                    <p class="text-xs font-semibold text-amber-300">🔒 Complete your profile</p>
                    <p class="text-[11px] text-amber-200/80 mt-0.5">The rest of EventWOS unlocks once you save your details.</p>
                </div>
                <NavItem Href="/profile" Icon="👤" Label="My Profile" />
            }
            else
            {

                @* Dashboard — everyone *@
                <NavItem Href="/dashboard" Icon="🏠" Label="Dashboard" />

                @* Events — permission-gated for Manager; always for Admin *@
                <AuthorizeView Roles="Admin">
                    <NavItem Href="/events" Icon="📅" Label="Events" />
                </AuthorizeView>
                <AuthorizeView Roles="Manager">
                    @if (_perms.Contains("events:read"))
                    {
                        <NavItem Href="/events" Icon="📅" Label="Events" />
                    }
                </AuthorizeView>
                <AuthorizeView Roles="Crew">
                    <NavItem Href="/my-events" Icon="📅" Label="My Events" />
                </AuthorizeView>
                <AuthorizeView Roles="Vendor">
                    <NavItem Href="/my-events" Icon="📅" Label="My Events" />
                </AuthorizeView>

                @* Admin always sees all nav *@
                <AuthorizeView Roles="Admin">
                    @* Users — one entry point that opens onto tabbed
                       Crew / Vendor / Manager / Admin screens (see
                       UserTabsHeader), instead of four separate links. *@
                    <NavItem Href="/users" Icon="👥" Label="Users" />
                    <NavItem Href="/attendance" Icon="📍" Label="Attendance" />
                    <NavItem Href="/payments" Icon="💰" Label="Payments" />
                    <NavItem Href="/sessions" Icon="🔌" Label="Sessions" />
                </AuthorizeView>

                @* Manager sees only links matching their permissions *@
                <AuthorizeView Roles="Manager">
                    @* Same single "Users" entry point as Admin, but only
                       shown if the Manager has been granted at least one
                       of the underlying read permissions — and it opens
                       on whichever tab they actually have access to. *@
                    @if (_perms.Contains("users:read") || _perms.Contains("vendors:read") || _perms.Contains("crew:read"))
                    {
                        <NavItem Href="@UsersLandingHref" Icon="👥" Label="Users" />
                    }
                    @if (_perms.Contains("attendance:read")) { <NavItem Href="/attendance" Icon="📍" Label="Attendance" /> }
                    @if (_perms.Contains("payments:read")) { <NavItem Href="/payments" Icon="💰" Label="Payments" /> }
                    @if (_perms.Contains("sessions:read")) { <NavItem Href="/sessions" Icon="🔌" Label="Sessions" /> }
                    @if (_perms.Contains("audit:read"))
                    {
                        <div class="pt-4 mt-4 border-t border-gray-700 space-y-1">
                            <NavItem Href="/admin/audit" Icon="📋" Label="Audit Log" />
                        </div>
                    }
                </AuthorizeView>

                @* Crew — My Assignments with pending badge + My Attendance *@
                <AuthorizeView Roles="Crew">
                    <div class="relative">
                        <NavItem Href="/my-assignments" Icon="📬" Label="My Assignments" />
                        @if (_pendingInvites > 0)
                        {
                            <span class="absolute top-1 right-2 w-4 h-4 rounded-full bg-red-500 text-white
                                         text-[9px] font-bold flex items-center justify-center pointer-events-none">
                                @_pendingInvites
                            </span>
                        }
                    </div>
                    <NavItem Href="/my-attendance" Icon="📍" Label="My Attendance" />
                    <NavItem Href="/my-payments"    Icon="💸" Label="My Payments" />
                    <div class="relative">
                        <NavItem Href="/notifications" Icon="📣" Label="Notifications" />
                        @if (_unreadNotifications > 0)
                        {
                            <span class="absolute top-1 right-2 w-4 h-4 rounded-full bg-red-500 text-white
                                         text-[9px] font-bold flex items-center justify-center pointer-events-none">
                                @_unreadNotifications
                            </span>
                        }
                    </div>
                </AuthorizeView>

                @* Vendor — My Crew + Crew Assignments + Attendance + Approvals + Payments + Report *@
                <AuthorizeView Roles="Vendor">
                    <NavItem Href="/crew"               Icon="👷" Label="My Crew" />
                    <NavItem Href="/my-crew-groups"     Icon="🧑‍🤝‍🧑" Label="Crew Groups" />
                    @* Attendance = Scan Check-In tab is the vendor's main
                       job on this page. Also gives them access to Logs
                       and per-event Summary for the crews they verified. *@
                    <NavItem Href="/attendance"          Icon="📍" Label="Attendance" />
                    <NavItem Href="/vendor-payments"     Icon="💸" Label="My Payments" />
                    <NavItem Href="/vendor-report"       Icon="📊" Label="My Report" />
                    <div class="relative">
                        <NavItem Href="/notifications" Icon="📣" Label="Notifications" />
                        @if (_unreadNotifications > 0)
                        {
                            <span class="absolute top-1 right-2 w-4 h-4 rounded-full bg-red-500 text-white
                                         text-[9px] font-bold flex items-center justify-center pointer-events-none">
                                @_unreadNotifications
                            </span>
                        }
                    </div>
                </AuthorizeView>

                @* Approval queue — every action role gets one entry.
                   Route is /approvals; the dispatcher page forwards to
                   the role-specific events page, then the tab header
                   lets the user switch to People. *@
                <AuthorizeView Roles="Admin,Manager,Vendor">
                    <div class="relative">
                        <NavItem Href="/approvals" Icon="✅" Label="Approval Queue" />
                        @if (_approvalCount > 0)
                        {
                            <span class="absolute top-1 right-2 px-1.5 py-0.5 rounded-full bg-red-500 text-white text-[10px] font-bold pointer-events-none">
                                @_approvalCount
                            </span>
                        }
                    </div>
                </AuthorizeView>

                @* Everyone *@
                <NavItem Href="/profile" Icon="👤" Label="My Profile" />

                @* Admin-only section *@
                <AuthorizeView Roles="Admin">
                    <div class="pt-4 mt-4 border-t border-gray-700 space-y-1">
                        <p class="px-2 text-xs font-semibold uppercase tracking-widest text-gray-500">Admin</p>
                        <NavItem Href="/admin/roles"          Icon="🛡️" Label="Roles" />
                        <NavItem Href="/admin/permissions"    Icon="🔑" Label="Permissions" />
                        <NavItem Href="/admin/settings/venue"   Icon="⚙️" Label="Settings" />
                        <NavItem Href="/admin/audit"          Icon="📋" Label="Audit Log" />
                    </div>
                </AuthorizeView>

            }
            </nav>

            <!-- User block -->
            <div class="p-4 border-t border-gray-700">
                <AuthorizeView>
                    <Authorized>
                        @{
                            var sbUsername = context.User.FindFirst("username")?.Value;
                            var sbMobile   = context.User.FindFirst("mobile")?.Value;
                            var sbRole     = context.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value
                                          ?? context.User.FindFirst("role")?.Value;
                            var sbInitialSource = !string.IsNullOrEmpty(sbUsername) ? sbUsername : (sbMobile ?? "?");
                        }
                        <div class="flex items-center gap-3">
                            <!-- Clicking the avatar or name/role text jumps to My Profile --
                                 same destination as the "My Profile" nav item above, just a
                                 faster path from wherever the sidebar is visible. Logout
                                 button stays outside this clickable area so it keeps its
                                 own single-purpose click target. -->
                            <div class="flex items-center gap-3 flex-1 min-w-0 cursor-pointer rounded-lg -m-1 p-1 hover:bg-gray-700/60 transition-colors"
                                 role="link" tabindex="0"
                                 @onclick="GoToProfile"
                                 @onkeydown="GoToProfileOnKey"
                                 title="Go to My Profile">
                                <div class="w-9 h-9 rounded-full bg-indigo-600 flex items-center justify-center text-sm font-bold uppercase flex-shrink-0">
                                    @sbInitialSource[0]
                                </div>
                                <div class="flex-1 min-w-0">
                                    <p class="text-sm font-medium text-white truncate">
                                        @@@(sbUsername ?? sbMobile)
                                    </p>
                                    <p class="text-xs text-gray-400 truncate">
                                        @sbRole · @sbMobile
                                    </p>
                                </div>
                            </div>
                            <button @onclick="LogoutAsync"
                                    class="text-gray-400 hover:text-white transition-colors" title="Logout">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5"
                                     viewBox="0 0 20 20" fill="currentColor">
                                    <path fill-rule="evenodd"
                                          d="M3 3a1 1 0 00-1 1v12a1 1 0 001 1h7a1 1 0 000-2H4V5h6a1 1 0 000-2H3zm11.707 4.293a1 1 0 010 1.414L13.414 10l1.293 1.293a1 1 0 01-1.414 1.414l-2-2a1 1 0 010-1.414l2-2a1 1 0 011.414 0z"
                                          clip-rule="evenodd" />
                                    <path d="M13 10a1 1 0 011-1h3a1 1 0 110 2h-3a1 1 0 01-1-1z" />
                                </svg>
                            </button>
                        </div>
                    </Authorized>
                </AuthorizeView>
            </div>

            <!-- Build version chip — reads /version.json emitted by the
                 Dockerfile. Tiny, unobtrusive, but decisive when
                 triaging cache/deploy questions ("is the user on the
                 fix?"). Shows short SHA + relative build time; the
                 title tooltip carries the full ISO timestamp. -->
            @if (!string.IsNullOrWhiteSpace(_buildSha))
            {
                <div class="px-4 pb-3 -mt-1">
                    <div class="text-[10px] text-gray-500 font-mono tracking-wide"
                         title="@($"Build {_buildSha} @ {_buildAt:u}")">
                        build @_buildSha · @_buildAgo
                    </div>
                </div>
            }
        </div>
    </aside>

    <!-- Main content -->
    <div class="flex flex-col flex-1 min-w-0 overflow-hidden">
        <header class="flex items-center justify-between h-16 px-4 md:px-6 bg-white border-b border-gray-200 shadow-sm">
            <div class="flex items-center gap-3 min-w-0">
                <!-- Mobile hamburger — hidden on md+ where the sidebar is always visible -->
                <button type="button" @onclick="() => _sidebarOpen = !_sidebarOpen"
                        class="md:hidden -ml-1 p-2 rounded-md text-gray-500 hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-indigo-500"
                        aria-label="Toggle navigation">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6"
                         fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="@(_sidebarOpen ? "M6 18L18 6M6 6l12 12" : "M4 6h16M4 12h16M4 18h16")" />
                    </svg>
                </button>
                <h1 class="text-lg font-semibold text-gray-800 truncate">@PageTitle</h1>
            </div>
            <div class="flex items-center gap-3">
                <div class="w-2 h-2 rounded-full @(Hub.IsConnected ? "bg-green-400" : "bg-red-400")"
                     title="@(Hub.IsConnected ? "Live" : "Reconnecting…")"></div>
                <span class="text-xs text-gray-400">@(Hub.IsConnected ? "Live" : "Reconnecting…")</span>
            </div>
        </header>
        <main class="flex-1 overflow-y-auto overflow-x-hidden p-4 md:p-6">@Body</main>
    </div>
</div>

<NotificationToast />

@* Invisible: forwards service-worker push messages into the app.
   See Components/PushMessageBridge.razor. *@
<PushMessageBridge />
<PwaInstallBanner />

@if (_termsStatus is { RequiresAcceptance: true })
{
    <div class="fixed inset-0 z-50 bg-black/60 flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-2xl w-full max-w-lg md:max-w-3xl lg:max-w-4xl max-h-[92vh] p-6 flex flex-col">
            <div class="flex-shrink-0">
                <h2 class="text-lg font-bold text-gray-900">Updated Terms &amp; Conditions</h2>
                <p class="text-sm text-gray-500 mt-1">
                    Our Terms &amp; Conditions for @_termsStatus.Audience accounts have changed. Please review and accept to continue.
                </p>
            </div>

            <div class="ql-editor flex-1 min-h-[45vh] md:min-h-[55vh] overflow-y-auto border border-gray-200 rounded-lg text-sm bg-gray-50 my-4" style="padding:1rem 1.25rem;">
                @((MarkupString)(_termsStatus.Content ?? ""))
            </div>

            <label class="flex items-start gap-2 text-sm text-gray-700 flex-shrink-0">
                <input type="checkbox" @bind="_termsAccepted" class="mt-0.5" />
                <span>I have read and accept the Terms &amp; Conditions above.</span>
            </label>

            @if (_termsError is not null)
            {
                <div class="px-3 py-2 rounded-lg bg-red-50 text-red-700 text-sm flex-shrink-0 mt-3">@_termsError</div>
            }

            <div class="flex items-center justify-between gap-3 pt-4 flex-shrink-0">
                <button @onclick="LogoutAsync" class="text-sm text-gray-500 hover:text-gray-700 underline">
                    Log out instead
                </button>
                <button @onclick="AcceptTermsAsync" disabled="@(!_termsAccepted || _termsAccepting)"
                        class="px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold transition disabled:opacity-50">
                    @(_termsAccepting ? "Accepting…" : "Accept & Continue")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private string PageTitle
    {
        get
        {
            if (Nav.Uri.Contains("/approvals", StringComparison.OrdinalIgnoreCase))
                return "Approval Queue";
            return Nav.Uri.Split('/').Last() switch
            {
        "dashboard"   => "Dashboard",
        "users"       => "Users",
        "managers"    => "Managers",
        "events"      => "Events",
        "vendors"     => "Vendors",
        "crew"        => "Crew",
        "payments"    => "Payments & Payroll",
        "sessions"    => "Sessions",
        "profile"     => "My Profile",
        "roles"       => "Roles",
        "permissions" => "Permissions",
        "audit"       => "Audit Log",
        "manager-approvals" => "Approval Queue",
        "approval-queue"    => "Registrations",
        "my-payments"       => "My Payments",
        "vendor-report"     => "My Performance Report",
                _             => "EventWOS"
            };
        }
    }

    // Mobile drawer visibility. Ignored on md+ where the sidebar is
    // permanently visible (Tailwind's md:translate-x-0 short-circuits us).
    private bool _sidebarOpen;

    // Current Manager's effective permissions (loaded from JWT claims)
    private HashSet<string> _perms = new(StringComparer.OrdinalIgnoreCase);

    // Where a Manager's single "Users" nav item should land — prefer the
    // Admin-accounts tab if they can see it, else fall back to whichever
    // of Vendor/Crew they actually have a read permission for. Keeps the
    // one nav entry from 404-ing into an access-denied screen.
    private string UsersLandingHref =>
        _perms.Contains("users:read")   ? "/users"   :
        _perms.Contains("vendors:read") ? "/vendors" :
        _perms.Contains("crew:read")    ? "/crew"    : "/users";

    // ── Directly-added-account profile-completion gate ───────────────────────
    // An Admin/Vendor can add a Crew/Vendor account directly (skips the
    // approval queue) — see CreateVendorCommand/CreateCrewCommand. That
    // account can reach the authenticated app via ANY login route (OTP,
    // password after /setup-password, etc). Wherever they come from, this
    // layout is the one place every authenticated page passes through, so
    // it's the single choke point: if the profile was never completed, we
    // collapse the sidebar to just "My Profile" and hard-redirect away from
    // every other route until they save it (which flips ProfileCompleted
    // server-side — see UpdateProfileHandler.MarkProfileCompletedIfFirstTime).
    private bool _mustCompleteProfile;

    // ── Post-login Terms & Conditions re-accept gate ───────────────────────
    // Admin/Manager never have a T&C audience — the endpoint returns
    // RequiresAcceptance=false for them and this stays null forever.
    private TermsStatusDto? _termsStatus;
    private bool _termsAccepted;
    private bool _termsAccepting;
    private string? _termsError;

    private async Task CheckTermsGateAsync()
    {
        try
        {
            var jsonOpts = new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            var resp = await Http.GetFromJsonAsync<TermsStatusEnvelope>("api/v1/terms/me/status", jsonOpts);
            _termsStatus = resp?.Data;
        }
        catch
        {
            // Fail open — same rationale as the profile-completion gate.
            _termsStatus = null;
        }
        StateHasChanged();
    }

    private async Task AcceptTermsAsync()
    {
        if (_termsStatus is null || _termsStatus.CurrentVersion is null) return;
        _termsAccepting = true;
        _termsError = null;
        try
        {
            var resp = await Http.PostAsJsonAsync("api/v1/terms/accept",
                new { Audience = _termsStatus.Audience, Version = _termsStatus.CurrentVersion });
            if (resp.IsSuccessStatusCode)
            {
                _termsStatus = null;
            }
            else
            {
                // Never assume the error body is valid JSON in our shape —
                // could be empty, or ASP.NET's own ProblemDetails format.
                string raw = "";
                try { raw = await resp.Content.ReadAsStringAsync(); } catch { }
                _termsError = "Couldn't record acceptance. Please try again.";
                if (!string.IsNullOrWhiteSpace(raw))
                {
                    try
                    {
                        var jsonOpts = new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true };
                        var body = System.Text.Json.JsonSerializer.Deserialize<ApiEnvelope>(raw, jsonOpts);
                        if (!string.IsNullOrWhiteSpace(body?.Message)) _termsError = body!.Message!;
                    }
                    catch { /* not JSON — keep the generic message */ }
                }
            }
        }
        catch { _termsError = "Network error. Please try again."; }
        finally { _termsAccepting = false; }
    }

    private sealed record TermsStatusDto(bool RequiresAcceptance, string? Audience, int? CurrentVersion, string? Content);
    private sealed record TermsStatusEnvelope(bool Success, TermsStatusDto? Data);
    private sealed record ApiEnvelope(bool Success, string? Message);

    protected override async Task OnInitializedAsync()
    {
        // Load permissions from JWT claims (already in auth state)
        var state = await AuthState.GetAuthenticationStateAsync();
        _perms = state.User
                      .FindAll(PermissionClaimTypes.Permission)
                      .Select(c => c.Value)
                      .ToHashSet(StringComparer.OrdinalIgnoreCase);

        // ─── Don't make authenticated calls without a session ────────────────
        // Every call below (/users/me, pending invites, approval count, the
        // SignalR hub) requires a live session. If the auth state says we're
        // anonymous — or we're holding a token the server has already rejected
        // — firing them just produces 401s, and a 401 trips the global
        // UnauthorizedRedirectHandler. That combination caused a production
        // reload loop: the handler force-navigates to /login, and a forceLoad
        // to the page you're already on is a plain reload, so the app rebooted
        // every ~1.5s and the login screen never stayed on screen. Bailing out
        // here means an unauthenticated render of this layout is completely
        // silent on the network.
        if (state.User.Identity?.IsAuthenticated != true)
            return;

        await CheckProfileCompletionGateAsync();
        await CheckTermsGateAsync();
        Nav.LocationChanged += OnLocationChanged;

        await LoadPendingInvites();
        await LoadApprovalCountAsync();
        await LoadUnreadNotificationsAsync();
        try { await Hub.StartAsync(); }
        catch { }
        Hub.ConnectionStateChanged += () => InvokeAsync(StateHasChanged);

        // Fire-and-forget the build-stamp fetch — never blocks layout render.
        _ = LoadBuildStampAsync();

        // ── Role-based permission priming ─────────────────────────
        // Fire OS-level prompts right after login (calm moment) instead
        // of mid-scan / mid-check-in (busy moment). One-shot per session
        // using sessionStorage so users aren't re-prompted on every page
        // load; browsers will silently return the cached answer anyway,
        // but this saves the async JS round-trip.
        //
        // Who needs what, post-crew-location refactor:
        //   * Vendors / Admins / Managers with attendance:verify
        //       → CAMERA only. They scan crew QR codes but no longer
        //         contribute location to the AttendanceRecord — the
        //         crew's own device is the source of truth now.
        //   * Crew
        //       → LOCATION only. Required for Check-In (server rejects
        //         missing coords) and Check-Out (same enforcement).
        //   * Everyone else (approvers, etc.) → nothing.
        _ = InvokeAsync(async () =>
        {
            try
            {
                var alreadyPrimed = await JS.InvokeAsync<string?>(
                    "sessionStorage.getItem", "eventwos_perms_primed");
                if (!string.IsNullOrEmpty(alreadyPrimed)) return;

                var role = state.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value
                           ?? state.User.FindFirst("role")?.Value;

                var wantsScan = role is "Vendor" or "Admin"
                                || (role is "Manager" && _perms.Contains("attendance:verify"));
                var wantsGeo  = role is "Crew";

                if (!wantsScan && !wantsGeo) return;

                await JS.InvokeVoidAsync(
                    "eventwosCheckin.primePermissions",
                    new { location = wantsGeo, camera = wantsScan });

                await JS.InvokeVoidAsync(
                    "sessionStorage.setItem", "eventwos_perms_primed", "1");
            }
            catch
            {
                // Prerender / JS not available / user closed the prompt.
                // Never a blocker — every downstream flow tolerates
                // missing permissions.
            }
        });

        // Keep sidebar counters live so the badge bumps without a refresh.
        // Any platform notification can change the badge, whatever produced it, so
        // this one subscription replaces the per-event wiring the legacy pushes need.
        Hub.PlatformNotificationReceived += OnPlatformCountChanged;

        // Web Push arriving while a tab is open. Separate from the SignalR
        // subscription above because the two transports are independent -- a
        // push can land when SignalR is disconnected, which is much of the point.
        Hub.PushReceived += OnPushReceived;

        Hub.AssignmentInviteReceived     += OnInviteCountChanged; // crew: new invite
        Hub.VendorApprovedReceived       += OnInviteCountChanged; // crew: state moved
        Hub.VendorRejectedReceived       += OnInviteCountChanged;
        Hub.ManagerApprovedReceived      += OnInviteCountChanged;
        Hub.ManagerRejectedReceived      += OnInviteCountChanged;
        Hub.PendingManagerApprovalReceived += OnApprovalCountChanged; // manager: queue grew
        Hub.EventAnnouncementReceived      += OnAnnouncementReceived; // vendor/crew: new event notification
    }

    private void OnInviteCountChanged(NotificationPayload payload)
    {
        _ = InvokeAsync(async () => { await LoadPendingInvites(); StateHasChanged(); });
    }

    private void OnAnnouncementReceived(NotificationPayload payload)
    {
        _ = InvokeAsync(async () => { await LoadUnreadNotificationsAsync(); StateHasChanged(); });
    }

    // A Web Push landed while the app was open. Same refetch as the SignalR
    // path, for the same reason: the two transports can deliver the same
    // notification, so the count must come from the server.
    private void OnPushReceived()
    {
        _ = InvokeAsync(async () =>
        {
            _unreadPlatform = await NotificationApi.UnreadCountAsync();
            StateHasChanged();
        });
    }

    private void OnPlatformCountChanged(PlatformNotification incoming)
    {
        // Refetched instead of incrementing locally: the same notification can
        // arrive twice across a reconnect, and an incremented badge would then
        // claim an unread that does not exist and never clear.
        _ = InvokeAsync(async () =>
        {
            _unreadPlatform = await NotificationApi.UnreadCountAsync();
            StateHasChanged();
        });
    }

    private void OnApprovalCountChanged(NotificationPayload payload)
    {
        _ = InvokeAsync(async () => { await LoadApprovalCountAsync(); StateHasChanged(); });
    }

    // ── Build version chip state ─────────────────────────────────────
    // Populated once at layout init from /version.json (produced by
    // the Dockerfile). Silent-fail on 404 or malformed JSON — the
    // chip just doesn't render, no user-visible error.
    private string  _buildSha = "";
    private DateTime _buildAt;
    private string  _buildAgo = "";

    private async Task LoadBuildStampAsync()
    {
        try
        {
            using var http = new HttpClient
            {
                BaseAddress = new Uri(Nav.BaseUri)
            };
            // Cache-bust so we always see the CURRENT deploy's version,
            // never a stale one the browser cached from a previous visit.
            var url = $"version.json?_cb={DateTimeOffset.UtcNow.ToUnixTimeSeconds()}";
            var v = await http.GetFromJsonAsync<VersionStamp>(url);
            if (v is not null && !string.IsNullOrWhiteSpace(v.Sha))
            {
                _buildSha = v.Sha;
                _buildAt  = v.BuiltAt;
                _buildAgo = FormatAgo(v.BuiltAt);
                StateHasChanged();
            }
        }
        catch
        {
            // No version.json (local dev, or Dockerfile skipped) — no chip.
        }
    }

    private static string FormatAgo(DateTime when)
    {
        var delta = DateTime.UtcNow - when.ToUniversalTime();
        if (delta.TotalSeconds < 60)    return "just now";
        if (delta.TotalMinutes < 60)    return $"{(int)delta.TotalMinutes}m ago";
        if (delta.TotalHours < 24)      return $"{(int)delta.TotalHours}h ago";
        if (delta.TotalDays < 30)       return $"{(int)delta.TotalDays}d ago";
        return when.ToString("yyyy-MM-dd");
    }

    private sealed record VersionStamp(string Sha, DateTime BuiltAt);

    private async Task LogoutAsync()
    {
        var refresh = await AuthState.GetRefreshTokenAsync();
        await AuthApi.LogoutAsync(refresh ?? string.Empty);
        await Hub.StopAsync();
        Nav.NavigateTo("/login");
    }

    // Sidebar user block: clicking the avatar/name/role area jumps to My
    // Profile (same target as the "My Profile" nav item), keyboard-reachable
    // too since it's a div acting as a link rather than a real <a>.
    private void GoToProfile() => Nav.NavigateTo("/profile");

    private void GoToProfileOnKey(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter" || e.Key == " ") GoToProfile();
    }

    private static string GetInitials(string mobile) =>
        mobile.Length >= 2 ? mobile[^2..] : mobile;

    // ── Pending invite badge (Crew role) ──────────────────────────────────────
    private int _pendingInvites;
    private int _approvalCount;

    private async Task LoadPendingInvites()
    {
        try
        {
            var authState = await AuthState.GetAuthenticationStateAsync();
            var role      = authState.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value
                         ?? authState.User.FindFirst("role")?.Value;
            if (role != "Crew") return;

            var data = await EventApi.GetMyAssignmentsAsync(page: 1);
            _pendingInvites = data?.Items.Count(a => a.Status == "Invited") ?? 0;
            StateHasChanged();
        }
        catch { }
    }

    // ── Unread event-notification badge (Crew + Vendor) ──────────────────────
    // Unread = an announcement for one of my events with no read receipt.
    // Only recipients have receipts, so this is meaningless for Admin/Manager
    // and skipped for them entirely.
    // Two independent sources behind ONE badge, because the /notifications page now
    // shows both feeds: admin-composed announcements and the notification
    // platform's activity. Kept as separate fields so a failure in one does not
    // zero the other -- a badge that silently drops half its count is worse than
    // one that is briefly high.
    private int _unreadAnnouncements;
    private int _unreadPlatform;

    private int _unreadNotifications => _unreadAnnouncements + _unreadPlatform;

    private async Task LoadUnreadNotificationsAsync()
    {
        try
        {
            var authState = await AuthState.GetAuthenticationStateAsync();
            var role      = authState.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value
                         ?? authState.User.FindFirst("role")?.Value;
            if (role is not ("Crew" or "Vendor")) return;

            var items = await AnnouncementApi.MineAsync(take: 100);
            _unreadAnnouncements = items.Count(a => !a.IsRead);

            // Counted server-side rather than by fetching rows and filtering: the
            // badge needs one number, and rendering thirty message bodies to
            // display it would be paid for on every page load.
            _unreadPlatform = await NotificationApi.UnreadCountAsync();

            StateHasChanged();
        }
        catch { }
    }

    // ── Sidebar approval-queue badge ─────────────────────────────────────────
    // Sums BOTH tabs of the unified /approvals page:
    //   • Events tab — Admin/Manager: assignments from vendors awaiting review
    //                  Vendor      : crew responses awaiting vendor review
    //   • People tab — Admin/Manager: pending vendor registrations
    //                  Vendor      : pending crew registrations under their code
    private async Task LoadApprovalCountAsync()
    {
        try
        {
            var authState = await AuthState.GetAuthenticationStateAsync();
            var role      = authState.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value
                         ?? authState.User.FindFirst("role")?.Value;
            if (role is not ("Admin" or "Manager" or "Vendor")) return;

            var jsonOpts = new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            int events = 0, people = 0;

            // ── Events tab count ──
            try
            {
                if (role is "Admin" or "Manager")
                {
                    var r = await Http.GetFromJsonAsync<ApprovalQueueResult>(
                        "api/v1/events/assignments/manager-queue?page=1&pageSize=1", jsonOpts);
                    events = r?.Data?.TotalCount ?? 0;
                }
                // Vendor events count is harder to fetch generically; the
                // VendorAssignments page sets _awaitingCount locally — for
                // the sidebar we just show People count when on Vendor.
            }
            catch { /* best-effort */ }

            // ── People tab count (role-scoped on backend) ──
            try
            {
                var r = await Http.GetFromJsonAsync<PeopleQueueResult>(
                    "api/v1/approval-queue", jsonOpts);
                people = (r?.Data?.VendorCount ?? 0) + (r?.Data?.CrewCount ?? 0);
            }
            catch { /* best-effort */ }

            _approvalCount = events + people;
            StateHasChanged();
        }
        catch { }
    }

    private sealed record ApprovalQueueResult(bool Success, ApprovalQueueData? Data);
    private sealed record ApprovalQueueData(int TotalCount);
    private sealed record PeopleQueueResult(bool Success, PeopleQueueData? Data);
    private sealed record PeopleQueueData(int VendorCount, int CrewCount);

    // ── Profile-completion gate ────────────────────────────────────────────
    private async Task CheckProfileCompletionGateAsync()
    {
        try
        {
            var me = await UserApi.GetMeAsync();
            _mustCompleteProfile = me is { WasDirectlyAdded: true, ProfileCompleted: false };
        }
        catch
        {
            // Network hiccup — fail open rather than locking someone out of
            // the whole app over a transient /users/me error. Re-checked on
            // every navigation anyway (OnLocationChanged), so it self-heals.
            _mustCompleteProfile = false;
        }

        if (_mustCompleteProfile && !Nav.Uri.Contains("/profile", StringComparison.OrdinalIgnoreCase))
            Nav.NavigateTo("/profile");

        StateHasChanged();
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        // Re-arm the redirect on every in-app navigation — a directly-added
        // user with an incomplete profile who tries to click/type their way
        // to any other page gets bounced straight back to /profile.
        if (_mustCompleteProfile && !e.Location.Contains("/profile", StringComparison.OrdinalIgnoreCase))
            Nav.NavigateTo("/profile");
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;

        // These were subscribed and NEVER removed. The layout usually outlives the
        // session so it rarely bit, but it is recreated on re-login -- and each new
        // instance left the previous one's handlers alive on the singleton-ish hub
        // service, so one invite refetched the counters once per stale layout and
        // the count could be written by a disposed component.
        Hub.PlatformNotificationReceived   -= OnPlatformCountChanged;
        Hub.PushReceived                   -= OnPushReceived;
        Hub.AssignmentInviteReceived       -= OnInviteCountChanged;
        Hub.VendorApprovedReceived         -= OnInviteCountChanged;
        Hub.VendorRejectedReceived         -= OnInviteCountChanged;
        Hub.ManagerApprovedReceived        -= OnInviteCountChanged;
        Hub.ManagerRejectedReceived        -= OnInviteCountChanged;
        Hub.PendingManagerApprovalReceived -= OnApprovalCountChanged;
        Hub.EventAnnouncementReceived      -= OnAnnouncementReceived;
    }
}
