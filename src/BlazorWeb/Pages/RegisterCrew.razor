@page "/register/crew"
@layout EventOpsOracle.BlazorWeb.Layout.EmptyLayout
@using Microsoft.AspNetCore.Components.Forms
@using EventOpsOracle.BlazorWeb.Validation
@inject IAuthApiService AuthApi
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Crew sign-up — OpsOracle</PageTitle>

<div class="min-h-screen bg-gradient-to-br from-gray-900 via-orange-950 to-gray-900 py-10 px-4">
    <div class="max-w-xl mx-auto">
        <div class="bg-white rounded-2xl shadow-2xl p-8">
            <div class="text-center mb-6">
                <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-orange-600 text-white text-2xl mb-3 shadow-lg">🧑‍🔧</div>
                <h1 class="text-2xl font-bold text-gray-900">Crew Sign-up</h1>
                <p class="text-sm text-gray-500 mt-1">Join OpsOracle under your vendor and start picking up shifts.</p>
            </div>

            @if (_success is not null)
            {
                <div class="px-4 py-4 rounded-xl bg-orange-50 border border-orange-200 text-orange-800 text-sm space-y-2">
                    <div class="font-semibold flex items-center gap-2">✅ Registration submitted</div>
                    <div>@_success</div>
                    <a href="/login/crew?reason=registered" class="inline-block text-orange-700 underline mt-1">Back to sign in</a>
                </div>
            }
            else
            {
                <div class="space-y-4">
                    @if (Ref is not null)
                    {
                        <div class="px-3 py-2 rounded-lg bg-orange-50 border border-orange-200 text-orange-800 text-xs flex items-center gap-2">
                            🎟️ <span>You're signing up under vendor referral code <strong>@Ref</strong>.</span>
                        </div>
                    }

                    <Field Label="Your full name" Required="true" Hint="Letters and spaces only">
                        <input @bind="_fullName" @bind:event="oninput" class="@FieldCss(_touchedFullName && !NameOk)" placeholder="Alex Roy"
                               @onblur='() => _touchedFullName = true' />
                    </Field>
                    @if (_touchedFullName && !NameOk)
                    {
                        <p class="text-xs text-red-600 -mt-2">Full name can only contain letters and spaces.</p>
                    }

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <Field Label="Username" Required="true" Hint="3–50 chars · letters, numbers, . _ -">
                            <input @bind="_username" @bind:event="oninput" class="@FieldCss(_touchedUsername && !UsernameOk)" placeholder="alexroy"
                                   autocomplete="username" @onblur='() => _touchedUsername = true' />
                        </Field>
                        <Field Label="Email" Required="true">
                            <input @bind="_email" @bind:event="oninput" type="email" class="@FieldCss(_touchedEmail && !EmailOk)" placeholder="you@example.com"
                                   autocomplete="email" @onblur='() => _touchedEmail = true' />
                        </Field>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 -mt-2">
                        <div>@if (_touchedUsername && !UsernameOk) { <p class="text-xs text-red-600">Only letters, numbers, '.', '_' or '-', 3–50 chars.</p> }</div>
                        <div>@if (_touchedEmail && !EmailOk) { <p class="text-xs text-red-600">Enter a valid email address.</p> }</div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <Field Label="Mobile" Required="true" Hint="Exactly 10 digits">
                            <input @ref="_mobileInputRef" value="@_mobile" @oninput="OnMobileInput" type="tel" inputmode="numeric" maxlength="10"
                                   class="@FieldCss(_touchedMobile && !MobileOk)" placeholder="9876543210" autocomplete="tel"
                                   @onblur='() => _touchedMobile = true' />
                        </Field>
                        <Field Label="Password" Required="true" Hint="Min 8 chars · 1 letter · 1 number">
                            <input @bind="_password" @bind:event="oninput" type="password" class="@FieldCss(_touchedPassword && !PasswordOk)" placeholder="••••••••"
                                   autocomplete="new-password" @onblur='() => _touchedPassword = true' />
                        </Field>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 -mt-2">
                        <div>@if (_touchedMobile && !MobileOk) { <p class="text-xs text-red-600">Mobile number must be exactly 10 digits.</p> }</div>
                        <div>@if (_touchedPassword && !PasswordOk) { <p class="text-xs text-red-600">@ClientValidation.PasswordDescription</p> }</div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <Field Label="Date of birth" Required="true" Hint="@AgeHint">
                            <input value="@_dobStr" @oninput="OnDobInput" type="date" min="@_minDob" max="@_maxDob" class="@FieldCss(_touchedDob && !DobOk)"
                                   @onblur='() => _touchedDob = true' />
                        </Field>
                        <Field Label="City">
                            <input @bind="_city" class="@Css" placeholder="Mumbai" />
                        </Field>
                    </div>
                    @if (_touchedDob && !DobOk)
                    {
                        <p class="text-xs text-red-600 -mt-2">You must be between @ClientValidation.MinimumAge and @(ClientValidation.MaximumAge - 1) years old to register.</p>
                    }

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <Field Label="Years of experience">
                            <input @bind="_years" type="number" min="0" max="60" class="@Css" placeholder="3" />
                        </Field>
                        <Field Label="Skills (comma-separated)" Hint="e.g. stage, lighting">
                            <input @bind="_skills" class="@Css" placeholder="stage, lighting" />
                        </Field>
                    </div>

                    <Field Label="Profile photo (optional)" Hint="@ClientFileValidation.ProfilePhoto.Description">
                        <InputFile OnChange="OnPhotoSelected" accept="image/jpeg,image/png,image/webp" class="@Css" />
                    </Field>
                    @if (_photoError is not null)
                    {
                        <p class="text-xs text-red-600 -mt-2">@_photoError</p>
                    }
                    else if (_photoBytes is not null)
                    {
                        <p class="text-xs text-green-700 -mt-2">✓ @_photoFileName selected</p>
                    }

                    <Field Label="Identification proof" Required="true" Hint="@($"Aadhaar / driving licence / voter ID — {ClientFileValidation.IdentificationProof.Description}")">
                        <InputFile OnChange="OnIdProofSelected" accept="image/jpeg,image/png,application/pdf" class="@Css" />
                    </Field>
                    @if (_idProofError is not null)
                    {
                        <p class="text-xs text-red-600 -mt-2">@_idProofError</p>
                    }
                    else if (_idProofBytes is not null)
                    {
                        <p class="text-xs text-green-700 -mt-2">✓ @_idProofFileName selected</p>
                    }

                    <Field Label="Vendor referral code" Required="true"
                           Hint="Ask your vendor for this code — it's how we link you to their roster.">
                        <input value="@_ref" @oninput="OnRefInput" @onblur="ValidateReferralAsync"
                               class="@Css uppercase" placeholder="ABC12345" disabled="@(_refLocked)" maxlength="20" />
                    </Field>
                    @if (_refChecking)
                    {
                        <p class="text-xs text-gray-500 -mt-2">Checking code…</p>
                    }
                    else if (_refValid == true)
                    {
                        <p class="text-xs text-green-700 -mt-2">✓ Valid — you'll join @(_refVendorName ?? "this vendor")</p>
                    }
                    else if (_refValid == false)
                    {
                        <p class="text-xs text-red-600 -mt-2">Not a valid vendor referral code.</p>
                    }

                    <Field Label="About you (optional)">
                        <textarea @bind="_bio" rows="3" class="@Css" placeholder="A short intro about your event experience."></textarea>
                    </Field>

                    @if (_termsContent is not null)
                    {
                        <div class="space-y-2">
                            <label class="text-sm font-medium text-gray-700">Terms &amp; Conditions <span class="text-red-500">*</span></label>
                            <div class="ql-editor h-40 overflow-y-auto border border-gray-200 rounded-lg text-xs bg-gray-50" style="padding:0.75rem;">@((MarkupString)_termsContent!)</div>
                            <label class="flex items-start gap-2 text-sm text-gray-700">
                                <input type="checkbox" @bind="_termsAccepted" class="mt-0.5" />
                                <span>I have read and accept the Terms &amp; Conditions above.</span>
                            </label>
                        </div>
                    }

                    @if (_error is not null)
                    {
                        <div class="px-3 py-2 rounded-lg bg-red-50 text-red-700 text-sm">@_error</div>
                    }

                    <button type="button" @onclick="SubmitAsync" disabled="@(_loading || !IsFormValid)"
                            class="w-full py-3 rounded-xl bg-orange-600 text-white font-medium shadow-md hover:bg-orange-700 disabled:opacity-50">
                        @(_loading ? "Submitting…" : "Submit registration")
                    </button>

                    <p class="text-center text-xs text-gray-500 pt-2">
                        Already have an account? <a href="/login/crew" class="text-orange-600 hover:underline">Sign in</a>
                    </p>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private const string Css = "w-full px-3 py-2.5 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-orange-500 text-sm";
    private const string CssError = "w-full px-3 py-2.5 border border-red-400 rounded-lg focus:outline-none focus:ring-2 focus:ring-red-400 text-sm";
    private static string FieldCss(bool hasError) => hasError ? CssError : Css;

    /// <summary>?ref=ABC123 — prefills + locks the referral code field.</summary>
    [SupplyParameterFromQuery(Name = "ref")] public string? Ref { get; set; }

    private string _username = "", _email = "", _mobile = "", _password = "", _fullName = "";
    private string? _city, _skills, _bio;
    private string? _ref;
    private int? _years;
    private bool _refLocked;
    private string? _error, _success;
    private bool _loading;

    private ElementReference _mobileInputRef;

    private bool _touchedFullName, _touchedUsername, _touchedEmail, _touchedMobile, _touchedPassword, _touchedDob;

    private DateTime? _dob;
    private string _dobStr = "";
    private readonly string _maxDob = DateTime.UtcNow.Date.ToString("yyyy-MM-dd");
    // Browser-level guard matching ClientValidation.MaximumAge — without a
    // `min` attribute a date input happily accepts something like
    // 0001-01-01, which is exactly what slipped an "Age: 2025 — OK" past
    // the old age>=18-only check.
    private readonly string _minDob = DateTime.UtcNow.Date.AddYears(-ClientValidation.MaximumAge).AddDays(1).ToString("yyyy-MM-dd");

    private byte[]? _photoBytes;    private string? _photoFileName, _photoContentType, _photoError;
    private byte[]? _idProofBytes;  private string? _idProofFileName, _idProofContentType, _idProofError;

    private string? _termsContent;
    private int _termsVersion;
    private bool _termsAccepted;

    private bool? _refValid;
    private string? _refVendorName;
    private bool _refChecking;

    // ── live validation state (mirrors server rules — see ClientValidation) ──
    private bool NameOk     => ClientValidation.IsValidFullName(_fullName);
    private bool UsernameOk => ClientValidation.IsValidUsername(_username);
    private bool EmailOk    => ClientValidation.IsValidEmail(_email);
    private bool MobileOk   => ClientValidation.IsValidMobile(_mobile);
    private bool PasswordOk => ClientValidation.IsValidPassword(_password);
    private bool DobOk      => _dob.HasValue && ClientValidation.IsAdult(_dob.Value);

    private bool IsFormValid =>
        NameOk && UsernameOk && EmailOk && MobileOk && PasswordOk && DobOk
        && !string.IsNullOrWhiteSpace(_ref) && _refValid != false
        && _idProofBytes is not null && _idProofError is null
        && _photoError is null
        && (_termsContent is null || _termsAccepted);

    private string AgeHint => _dob switch
    {
        null => $"Must be {ClientValidation.MinimumAge}–{ClientValidation.MaximumAge - 1} years old",
        { } d when ClientValidation.IsAdult(d) => $"Age: {ClientValidation.CalculateAge(d)} — OK ✓",
        { } d when ClientValidation.CalculateAge(d) >= ClientValidation.MaximumAge
            => $"Age: {ClientValidation.CalculateAge(d)} — must be below {ClientValidation.MaximumAge}",
        { } d => $"Age: {ClientValidation.CalculateAge(d)} — must be at least {ClientValidation.MinimumAge}"
    };

    protected override void OnInitialized()
    {
        if (!string.IsNullOrWhiteSpace(Ref))
        {
            _ref = Ref.Trim().ToUpperInvariant();
            _refLocked = true;
            _refValid = null; // still validate it on load in case it's stale/expired
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (_refLocked && !string.IsNullOrWhiteSpace(_ref))
            await ValidateReferralAsync();

        try
        {
            var terms = await AuthApi.GetCurrentTermsAsync("Crew");
            if (terms.Success && terms.Data is not null)
            {
                _termsContent = terms.Data.Content;
                _termsVersion = terms.Data.Version;
            }
        }
        catch { /* no T&C published yet, or transient error — registration still works without it */ }
    }

    private void OnDobInput(ChangeEventArgs e)
    {
        _dobStr = e.Value?.ToString() ?? "";
        _dob = DateTime.TryParse(_dobStr, out var d) ? d.Date : null;
    }

    /// <summary>
    /// Filters to digits-only, then force-writes the result straight onto the
    /// DOM node via JS interop. The plain C#-state round-trip alone doesn't
    /// work here: if the filtered value happens to equal the PREVIOUS render
    /// (e.g. every non-digit keystroke on an empty field filters back to
    /// ""), Blazor's diffing sees no change and skips updating the real
    /// input, leaving the raw unfiltered character visibly stuck in the box.
    /// See wwwroot/js/forms.js for the interop function.
    /// </summary>
    private async Task OnMobileInput(ChangeEventArgs e)
    {
        _mobile = ClientValidation.FilterDigits(e.Value?.ToString(), 10);
        await JS.InvokeVoidAsync("opsOracleForms.setInputValue", _mobileInputRef, _mobile);
    }

    private void OnRefInput(ChangeEventArgs e)
    {
        _ref = (e.Value?.ToString() ?? "").ToUpperInvariant();
        _refValid = null;
    }

    private async Task ValidateReferralAsync()
    {
        if (string.IsNullOrWhiteSpace(_ref)) { _refValid = null; return; }
        _refChecking = true;
        try
        {
            var result = await AuthApi.CheckReferralCodeAsync(_ref);
            _refValid = result.Data?.IsValid ?? false;
            _refVendorName = result.Data?.VendorBusinessName;
        }
        catch { _refValid = null; }
        finally { _refChecking = false; }
    }

    private async Task OnPhotoSelected(InputFileChangeEventArgs e)
    {
        _photoError = null; _photoBytes = null;
        var file = e.File;
        var (isValid, error) = ClientFileValidation.Validate(ClientFileValidation.ProfilePhoto, file.Size, file.ContentType, file.Name);
        if (!isValid) { _photoError = error; return; }

        using var ms = new MemoryStream();
        await file.OpenReadStream(ClientFileValidation.ProfilePhoto.MaxSizeBytes + 1024).CopyToAsync(ms);
        _photoBytes = ms.ToArray();
        _photoFileName = file.Name;
        _photoContentType = file.ContentType;
    }

    private async Task OnIdProofSelected(InputFileChangeEventArgs e)
    {
        _idProofError = null; _idProofBytes = null;
        var file = e.File;
        var (isValid, error) = ClientFileValidation.Validate(ClientFileValidation.IdentificationProof, file.Size, file.ContentType, file.Name);
        if (!isValid) { _idProofError = error; return; }

        using var ms = new MemoryStream();
        await file.OpenReadStream(ClientFileValidation.IdentificationProof.MaxSizeBytes + 1024).CopyToAsync(ms);
        _idProofBytes = ms.ToArray();
        _idProofFileName = file.Name;
        _idProofContentType = file.ContentType;
    }

    private async Task SubmitAsync()
    {
        _error = null;
        // Mark everything touched so any remaining issue shows inline, even
        // if the button were somehow clicked before a field lost focus.
        _touchedFullName = _touchedUsername = _touchedEmail = _touchedMobile = _touchedPassword = _touchedDob = true;

        if (!IsFormValid)
        {
            _error = "Please fix the highlighted fields before submitting.";
            return;
        }

        _loading = true;
        try
        {
            var req = new RegisterCrewRequest(
                _username.Trim(), _email.Trim(), _mobile.Trim(), _password, _fullName.Trim(),
                _dob!.Value,
                string.IsNullOrWhiteSpace(_ref) ? null : _ref!.Trim(),
                _city, _skills, _years, _bio,
                _idProofBytes!, _idProofFileName ?? "id-proof", _idProofContentType ?? "application/octet-stream",
                _photoBytes, _photoFileName, _photoContentType,
                _termsContent is null || _termsAccepted, _termsVersion);
            var result = await AuthApi.RegisterCrewAsync(req);
            if (!result.Success)
            {
                _error = result.Errors?.FirstOrDefault() ?? result.Message ?? "Registration failed.";
                return;
            }
            _success = result.Data?.Message ?? "We've received your registration.";
        }
        catch { _error = "Network error. Please try again."; }
        finally { _loading = false; }
    }
}
