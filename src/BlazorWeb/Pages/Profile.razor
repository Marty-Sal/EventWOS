        _showFormatMenu = false;
        _showEmojiMenu = false;
    }

    private async Task OnTemplateInput(ChangeEventArgs e)
    {
        var value = e.Value?.ToString() ?? "";
        // Native maxlength stops typed input, but a paste can still blow past
        // it — clamp defensively and force the trimmed value back onto the
        // DOM node (same pattern as eventwosForms.setInputValue elsewhere).
        if (value.Length > 500)
        {
            value = value[..500];
            await JS.InvokeVoidAsync("eventwosForms.setInputValue", _templateRef, value);
        }
        _inviteMessageTemplate = value;
    }

    /// <summary>Inserts <paramref name="text"/> at the current cursor
    /// position (replacing any active selection), then restores the caret
    /// right after the inserted text.</summary>
    private async Task InsertAtCursorAsync(string text)
    {
        var range = await JS.InvokeAsync<int[]>("eventwosForms.getSelectionRange", _templateRef);
        var current = _inviteMessageTemplate ?? "";
        var start = Math.Clamp(range.ElementAtOrDefault(0), 0, current.Length);
        var end = Math.Clamp(range.ElementAtOrDefault(1), start, current.Length);

        var updated = current[..start] + text + current[end..];
        _inviteMessageTemplate = updated;
        StateHasChanged();

        await JS.InvokeVoidAsync("eventwosForms.setInputValue", _templateRef, updated);
        var caret = start + text.Length;
        await JS.InvokeVoidAsync("eventwosForms.setSelectionRange", _templateRef, caret, caret);
    }

    /// <summary>Inserts the vendor's actual, already-resolved invite URL
    /// at the cursor — not a "{link}" placeholder token. What you see in
    /// the box is exactly what gets sent, no hidden substitution step.</summary>
    private Task InsertLinkToken() => InsertAtCursorAsync(InviteLink);

    private async Task InsertEmoji(string emoji)
    {
        await InsertAtCursorAsync(emoji);
        _showEmojiMenu = false;
    }

    /// <summary>Wraps the current selection in WhatsApp-style markup
    /// (*bold*, _italic_, ~strike~). Clicking again on an already-wrapped
    /// selection removes the markers instead of stacking a second pair —
    /// a real toggle, not just an "add" button.</summary>
    private async Task WrapSelection(string marker)
    {
        var range = await JS.InvokeAsync<int[]>("eventwosForms.getSelectionRange", _templateRef);
        var current = _inviteMessageTemplate ?? "";
        var start = Math.Clamp(range.ElementAtOrDefault(0), 0, current.Length);
        var end = Math.Clamp(range.ElementAtOrDefault(1), start, current.Length);

        var alreadyWrapped =
            start >= marker.Length && end + marker.Length <= current.Length &&
            current.Substring(start - marker.Length, marker.Length) == marker &&
            current.Substring(end, marker.Length) == marker;

        string updated;
        int newStart, newEnd;

        if (alreadyWrapped)
        {
            updated = current[..(start - marker.Length)] + current[start..end] + current[(end + marker.Length)..];
            newStart = start - marker.Length;
            newEnd = end - marker.Length;
        }
        else
        {
            var selected = current[start..end];
            updated = current[..start] + marker + selected + marker + current[end..];
            newStart = selected.Length == 0 ? start + marker.Length : start + marker.Length;
            newEnd = selected.Length == 0 ? newStart : newStart + selected.Length;
        }

        _inviteMessageTemplate = updated;
        StateHasChanged();

        await JS.InvokeVoidAsync("eventwosForms.setInputValue", _templateRef, updated);
        await JS.InvokeVoidAsync("eventwosForms.setSelectionRange", _templateRef, newStart, newEnd);
        _showFormatMenu = false;
    }

    /// <summary>Copies the FULL composed message (template with {link}
    /// resolved to the real invite URL) — distinct from the "📋 Copy link"
    /// button above, which only copies the bare URL.</summary>
    private async Task CopyMessage()
    {
        var (text, _) = BuildShareContent();
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
            _messageCopied = true; StateHasChanged();
            await Task.Delay(2000);
            _messageCopied = false; StateHasChanged();
        }
        catch { }
    }

    // Crew join vendor
    private string  _joinCode    = "";
    private bool    _joining;
    private string? _joinError;
    private bool    _joinSuccess;

    // Toast
    private string? _toast;
    private bool    _toastErr;

    private static readonly System.Text.Json.JsonSerializerOptions JsonOpts =
        new() { PropertyNameCaseInsensitive = true };

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true; _loadError = null; StateHasChanged();
        try
        {
            _profile = await UserApi.GetMeAsync();
            if (_profile is not null)
            {
                _fullName = _profile.FullName;
                _email    = _profile.Email;
                _inviteMessageTemplate = string.IsNullOrWhiteSpace(_profile.InviteMessageTemplate)
                    ? BuildDefaultInviteMessage()
                    : _profile.InviteMessageTemplate;
                HydrateExtendedFields(_profile);
            }
        }
        catch (Exception ex) { _loadError = ex.Message; }
        finally { _loading = false; StateHasChanged(); }
    }

    private void HydrateExtendedFields(UserProfileDto p)
    {
        _dob = p.DateOfBirth;
        _dobStr = p.DateOfBirth?.ToString("yyyy-MM-dd") ?? "";
        _city = p.City;
        _state = p.State;
        _address = p.Address;
        _bio = p.Bio;
        _skills = p.Skills;
        _experienceYears = p.ExperienceYears;
        _contactPersonName = p.ContactPersonName;
        _gstNumber = p.GstNumber;
        _website = p.Website;
    }

    private async Task SaveAsync()
    {
        if (MustComplete && !CanSubmitCompletion)
        {
            _touchedDob = true;
            StateHasChanged();
            // The inline "Save" button up in the invite-message composer can hit
            // this same gate if required profile fields further down aren't
            // filled in yet — a toast makes that visible without having to
            // scroll down to spot the (also-shown) inline field error.
            ShowToast("Please fill in the required profile fields below before saving.", err: true);
            return;
        }

        var wasIncomplete = MustComplete;
        _saving = true; _saveError = null; _saveSuccess = false; StateHasChanged();
        var ok = await UserApi.UpdateProfileAsync(
            _fullName ?? "", _email, _profile?.AvatarUrl, _inviteMessageTemplate ?? "",
            _dob, _city, _state, _address, _bio, _skills, _experienceYears,
            _profile?.BusinessName, _contactPersonName, _gstNumber, _website);
        if (ok)
        {
            _saveSuccess = true;
            ShowToast("Profile saved!", err: false);

            // First-time completion of a directly-added account — force a full
            // reload so MainLayout re-fetches /users/me, sees ProfileCompleted=true,
            // and lifts the "only /profile is reachable" gate.
            if (wasIncomplete)
            {
                Nav.NavigateTo("/dashboard", forceLoad: true);
                return;
            }

            _profile = await UserApi.GetMeAsync();
            if (_profile is not null)
            {
                _fullName = _profile.FullName; _email = _profile.Email;
                _inviteMessageTemplate = string.IsNullOrWhiteSpace(_profile.InviteMessageTemplate)
                    ? BuildDefaultInviteMessage()
                    : _profile.InviteMessageTemplate;
                HydrateExtendedFields(_profile);
            }
        }
        else
        {
            _saveError = "Failed to update profile. Please try again.";
            ShowToast(_saveError, err: true);
        }
        _saving = false; StateHasChanged();
        _ = Task.Delay(3000).ContinueWith(_ => { _saveSuccess = false; InvokeAsync(StateHasChanged); });
    }

    private async Task JoinVendorAsync()
    {
        _joinError = null; _joinSuccess = false;
        if (string.IsNullOrWhiteSpace(_joinCode)) { _joinError = "Please enter a referral code."; return; }
        _joining = true; StateHasChanged();
        try
        {
            var resp = await Http.PostAsJsonAsync(
                "api/v1/crew/join-vendor", new { referralCode = _joinCode.Trim().ToUpper() });
            if (resp.IsSuccessStatusCode)
            {
                _joinSuccess = true; _joinCode = "";
                ShowToast("Joined vendor successfully! Reload the page to see your vendor.", false);
                await LoadAsync();
            }
            else
            {
                var body = await resp.Content.ReadFromJsonAsync<ApiError>(JsonOpts);
                _joinError = body?.Message ?? "Invalid referral code.";
            }
        }
        catch { _joinError = "Network error. Please try again."; }
        finally { _joining = false; StateHasChanged(); }
    }

    // ── Crew invite link ────────────────────────────────────────────────────
    // No longer surfaced as its own box — folded into the message composer
    // below. Kept here purely as the per-vendor URL the {link} token and
    // "Insert Invite Link" button resolve to.
    private string InviteLink => _profile?.ReferralCode is null
        ? string.Empty
        : $"{Nav.BaseUri.TrimEnd('/')}/register/crew?ref={Uri.EscapeDataString(_profile.ReferralCode)}";

    /// <summary>Seeded into the composer whenever the vendor has no saved
    /// template yet, so the box is never just empty placeholder text —
    /// there's always a real, ready-to-send message with the vendor's
    /// actual invite URL already embedded (not a "{link}" token — a
    /// method, not a const, since it needs the live per-vendor
    /// <see cref="InviteLink"/>).</summary>
    private string BuildDefaultInviteMessage() =>
        $"Hey! 👋\nJoin my crew on EventWOS — sign up here: {InviteLink}";

    /// <summary>
    /// Builds the share text from whatever's currently in the composer
    /// (the live `_inviteMessageTemplate`, not the last-saved profile
    /// value — Copy/Share should reflect what's on screen even if the
    /// vendor hasn't hit Save yet).
    /// The real URL is normally already embedded literally in the text
    /// (inserted via the "Insert Invite Link" button, or present in the
    /// default message) — we don't append it again. The "{link}" token
    /// is still honored if someone types it manually, for anyone who
    /// prefers writing the message before placing the link.
    /// </summary>
    private (string Text, string Url) BuildShareContent()
    {
        var template = string.IsNullOrWhiteSpace(_inviteMessageTemplate)
            ? BuildDefaultInviteMessage()
            : _inviteMessageTemplate;

        if (template.Contains("{link}"))
            template = template.Replace("{link}", InviteLink);

        return (template, string.Empty);
    }

    /// <summary>Opens the OS share sheet on mobile (Web Share API) or
    /// falls back to copying the composed message + a toast on desktop.</summary>
    private async Task ShareInviteLink()
    {
        if (string.IsNullOrEmpty(InviteLink)) return;
        var (text, url) = BuildShareContent();
        var shared = false;
        try
        {
            shared = await JS.InvokeAsync<bool>("eventwosForms.share", "Join my crew on EventWOS", text, url);
        }
        catch { }
        if (!shared)
        {
            await CopyMessage();
            ShowToast("Share menu unavailable — message copied instead.", err: false);
        }
    }


    private async Task CopyReferralCode()
    {
        if (_profile?.ReferralCode is null) return;
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _profile.ReferralCode);
            _copied = true; StateHasChanged();
            await Task.Delay(2000);
            _copied = false; StateHasChanged();
        }
        catch { }
    }

    private void ShowToast(string msg, bool err)
    {
        _toast = msg; _toastErr = err; StateHasChanged();
        _ = Task.Delay(4000).ContinueWith(_ => { _toast = null; InvokeAsync(StateHasChanged); });
    }

    private static string DisciplineChip(decimal score) =>
        score >= 80 ? "text-green-600" : score >= 50 ? "text-amber-600" : "text-red-600";

    private sealed record ApiError(bool Success, string? Message);
