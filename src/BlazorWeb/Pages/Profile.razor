@page "/profile"
@attribute [Authorize]
@using EventWOS.BlazorWeb.Validation
@inject IUserApiService UserApi
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>My Profile — EventWOS</PageTitle>

<div class="max-w-2xl mx-auto space-y-6">

    @if (!_loading && _profile is not null && _profile.WasDirectlyAdded && !_profile.ProfileCompleted)
    {
        <div class="bg-amber-50 border-2 border-amber-300 rounded-2xl p-5">
            <p class="font-semibold text-amber-800 flex items-center gap-2">🔒 Complete your profile to continue</p>
            <p class="text-sm text-amber-700 mt-1">
                An admin/vendor added your account directly. Fill in the required details below and save —
                you won't be able to use the rest of EventWOS until this is done.
            </p>
        </div>
    }

    @if (_loading)
    {
        <div class="flex items-center justify-center py-16">
            <svg class="animate-spin h-8 w-8 text-indigo-500" viewBox="0 0 24 24" fill="none">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z"/>
            </svg>
        </div>
    }
    else if (_loadError is not null)
    {
        <div class="bg-red-50 border border-red-100 rounded-2xl p-6 text-red-600 text-sm">
            <p class="font-semibold mb-1">⚠️ Could not load profile</p>
            <p class="text-xs text-red-400">@_loadError</p>
            <button @onclick="LoadAsync" class="mt-3 px-4 py-2 rounded-xl bg-red-600 text-white text-xs font-medium hover:bg-red-700 transition">Try again</button>
        </div>
    }
    else if (_profile is not null)
    {
        @* ── Profile header ───────────────────────────────────────────────────── *@
        <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6">
            <div class="flex items-center gap-5">
                <div class="w-16 h-16 rounded-2xl bg-indigo-600 text-white flex items-center justify-center text-2xl font-bold shadow-md">
                    @(_profile.FullName?.FirstOrDefault().ToString() ?? _profile.Mobile.Last().ToString())
                </div>
                <div>
                    <h2 class="text-xl font-bold text-gray-800">@(_profile.FullName ?? "—")</h2>
                    <p class="text-sm text-gray-500 flex items-center gap-2 flex-wrap">
                        <span class="font-mono text-indigo-700">@@@_profile.Username</span>
                        <span class="text-gray-300">·</span>
                        <span>@_profile.Mobile</span>
                    </p>
                    <div class="flex items-center gap-2 mt-1 flex-wrap">
                        <span class="px-2 py-0.5 rounded-full text-xs font-medium bg-indigo-100 text-indigo-700">@_profile.Role</span>
                        <span class="px-2 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-700">@_profile.Status</span>
                        @if (_profile.Role == "Vendor" && _profile.Rating.HasValue)
                        {
                            <span class="px-2 py-0.5 rounded-full text-xs font-medium bg-amber-100 text-amber-700">⭐ @_profile.Rating.Value.ToString("F1")</span>
                        }
                        @if (_profile.Role == "Crew" && _profile.DisciplineScore.HasValue)
                        {
                            <span class="px-2 py-0.5 rounded-full text-xs font-medium @DisciplineChip(_profile.DisciplineScore.Value)">
                                🎯 Score: @_profile.DisciplineScore.Value.ToString("F0")
                            </span>
                        }
                    </div>
                </div>
            </div>
        </div>

        @* ── Role-specific info cards ──────────────────────────────────────────── *@
        @if (_profile.Role == "Vendor")
        {
            <div class="bg-white rounded-2xl border border-indigo-100 shadow-sm p-6 space-y-4">
                <h3 class="text-sm font-semibold text-gray-700">🏢 Vendor Information</h3>
                @if (_profile.BusinessName is not null)
                {
                    <div class="flex justify-between items-center py-2 border-b border-gray-50">
                        <span class="text-sm text-gray-500">Business Name</span>
                        <span class="font-medium text-gray-800">@_profile.BusinessName</span>
                    </div>
                }
                <div class="space-y-2">
                    <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Your Referral Code</p>
                    <div class="flex items-center gap-3">
                        <code class="flex-1 px-4 py-3 bg-indigo-50 border border-indigo-200 rounded-xl text-lg font-bold text-indigo-700 tracking-widest text-center">
                            @(_profile.ReferralCode ?? "—")
                        </code>
                        @if (_profile.ReferralCode is not null)
                        {
                            <button @onclick="CopyReferralCode"
                                    class="px-4 py-3 rounded-xl bg-indigo-600 text-white text-xs font-semibold hover:bg-indigo-700 transition shadow-sm">
                                @(_copied ? "✅ Copied!" : "📋 Copy")
                            </button>
                        }
                    </div>
                    <p class="text-xs text-gray-400">Share this code with crew members so they can join your roster.</p>
                </div>


                @* Custom invite message composer — Gmail-style: editable body on
                   top, toolbar pinned to the bottom. {link} token gets swapped
                   for the real invite URL on Copy/Share; if omitted, the link
                   is appended to the end of whatever the vendor writes.
                   Formatting uses WhatsApp's own *bold*/_italic_/~strike~
                   markup (not HTML) — that's what actually survives when the
                   message is copied or shared into WhatsApp/SMS, so what you
                   see here is exactly what recipients will see. *@
                <div class="space-y-2 pt-2 border-t border-gray-100">
                    <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Custom Invite Message</p>

                    @if (_showFormatMenu || _showEmojiMenu)
                    {
                        <div class="fixed inset-0 z-40" @onclick="CloseMenus"></div>
                    }

                    <div class="rounded-xl border border-gray-200 overflow-hidden focus-within:ring-2 focus-within:ring-indigo-500">
                        <textarea @ref="_templateRef" value="@_inviteMessageTemplate" @oninput="OnTemplateInput"
                                  rows="4" maxlength="500"
                                  placeholder="Hey! Join my crew on EventWOS — sign up here: {link}"
                                  class="w-full px-4 py-3 text-sm focus:outline-none resize-none block"></textarea>

                        @* Bottom toolbar — mirrors an email compose bar: primary
                           actions on the left, formatting tools after a divider. *@
                        <div class="flex items-center gap-1.5 px-3 py-2 bg-gray-50 border-t border-gray-100 relative">
                            <button type="button" @onclick="CopyMessage"
                                    class="px-3 py-1.5 rounded-lg bg-indigo-600 text-white text-xs font-semibold hover:bg-indigo-700 transition whitespace-nowrap">
                                @(_messageCopied ? "✅ Copied!" : "📋 Copy")
                            </button>
                            <button type="button" @onclick="ShareInviteLink"
                                    class="px-3 py-1.5 rounded-lg bg-white border border-gray-200 text-gray-700 text-xs font-semibold hover:bg-gray-100 transition whitespace-nowrap">
                                📤 Share
                            </button>

                            @* Saves the whole profile (same call as the main "Save
                               Changes" button at the bottom) so the vendor doesn't
                               have to scroll all the way down just to persist a
                               message they edited up here. Feedback comes via the
                               toast since the far-away success/error text under the
                               main button wouldn't be visible from this scroll spot. *@
                            <button type="button" @onclick="SaveAsync" disabled="@_saving"
                                    title="Save this message to your profile"
                                    class="px-3 py-1.5 rounded-lg bg-emerald-600 text-white text-xs font-semibold hover:bg-emerald-700 transition whitespace-nowrap disabled:opacity-60">
                                @(_saving ? "Saving…" : "💾 Save")
                            </button>

                            <span class="w-px h-5 bg-gray-200 mx-1"></span>

                            @* Aa — text formatting (WhatsApp markdown) *@
                            <div class="relative">
                                <button type="button" @onclick="ToggleFormatMenu" title="Formatting"
                                        class="w-8 h-8 flex items-center justify-center rounded-lg text-sm font-bold text-gray-600 hover:bg-gray-200 transition">
                                    Aa
                                </button>
                                @if (_showFormatMenu)
                                {
                                    <div class="absolute bottom-full mb-2 left-0 bg-white rounded-xl border border-gray-200 shadow-lg p-1.5 flex gap-1 z-50" @onclick:stopPropagation="true">
                                        <button type="button" @onclick='() => WrapSelection("*")' title="Bold"
                                                class="w-9 h-9 flex items-center justify-center rounded-lg font-bold text-gray-700 hover:bg-gray-100 transition">B</button>
                                        <button type="button" @onclick='() => WrapSelection("_")' title="Italic"
                                                class="w-9 h-9 flex items-center justify-center rounded-lg italic text-gray-700 hover:bg-gray-100 transition">I</button>
                                        <button type="button" @onclick='() => WrapSelection("~")' title="Strikethrough"
                                                class="w-9 h-9 flex items-center justify-center rounded-lg line-through text-gray-700 hover:bg-gray-100 transition">S</button>
                                    </div>
                                }
                            </div>

                            @* Emoji picker *@
                            <div class="relative">
                                <button type="button" @onclick="ToggleEmojiMenu" title="Insert emoji"
                                        class="w-8 h-8 flex items-center justify-center rounded-lg text-base hover:bg-gray-200 transition">
                                    😀
                                </button>
                                @if (_showEmojiMenu)
                                {
                                    <div class="absolute bottom-full mb-2 left-0 bg-white rounded-xl border border-gray-200 shadow-lg p-2 grid grid-cols-8 gap-0.5 z-50 w-64" @onclick:stopPropagation="true">
                                        @foreach (var emoji in EmojiChoices)
                                        {
                                            <button type="button" @onclick="() => InsertEmoji(emoji)"
                                                    class="w-7 h-7 flex items-center justify-center rounded-lg text-base hover:bg-gray-100 transition">
                                                @emoji
                                            </button>
                                        }
                                    </div>
                                }
                            </div>

                            <span class="w-px h-5 bg-gray-200 mx-1"></span>

                            @* Insert invite link at cursor — the one custom action
                               that isn't a generic email-toolbar icon, so it's
                               spelled out rather than left as a bare glyph. *@
                            <button type="button" @onclick="InsertLinkToken" title="Insert your invite link at the cursor"
                                    class="px-3 py-1.5 rounded-lg bg-white border border-indigo-200 text-indigo-700 text-xs font-semibold hover:bg-indigo-50 transition whitespace-nowrap ml-auto">
                                🔗 Insert Invite Link
                            </button>
                        </div>
                    </div>

                    <p class="text-xs text-gray-400">Use <code class="px-1 bg-gray-100 rounded">{link}</code> or the <span class="font-semibold text-indigo-600">Insert Invite Link</span> button to place your invite link. Anyone who opens it sees the sign-up form with your referral code already filled in.</p>
                </div>
            </div>
        }

        @if (_profile.Role == "Crew")
        {
            <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6 space-y-4">
                <h3 class="text-sm font-semibold text-gray-700">👷 Crew Stats</h3>
                <div class="grid grid-cols-2 gap-4">
                    <div class="bg-indigo-50 rounded-xl p-4 border border-indigo-100 text-center">
                        <p class="text-xs text-indigo-500 mb-1">Discipline Score</p>
                        <p class="text-3xl font-bold @DisciplineChip(_profile.DisciplineScore ?? 100)">
                            @((_profile.DisciplineScore ?? 100).ToString("F0"))
                        </p>
                        <p class="text-xs text-gray-400 mt-0.5">out of 100</p>
                    </div>
                    <div class="bg-gray-50 rounded-xl p-4 border border-gray-100 text-center">
                        <p class="text-xs text-gray-500 mb-1">Events Attended</p>
                        <p class="text-3xl font-bold text-gray-800">@(_profile.EventsAttended ?? 0)</p>
                        <p class="text-xs text-gray-400 mt-0.5">total completed</p>
                    </div>
                </div>

                @* Vendor affiliation *@
                @if (_profile.VendorId.HasValue)
                {
                    <div class="flex items-center gap-3 py-3 border-t border-gray-50 mt-2">
                        <div class="w-9 h-9 rounded-full bg-green-100 flex items-center justify-center text-green-700 font-bold text-sm shrink-0">
                            🏢
                        </div>
                        <div>
                            <p class="text-xs text-gray-400">Affiliated Vendor</p>
                            <p class="font-semibold text-gray-800 text-sm">@(_profile.VendorName ?? "Unknown Vendor")</p>
                        </div>
                        <span class="ml-auto px-2 py-0.5 rounded-full text-[11px] font-medium bg-green-50 text-green-700 border border-green-200">Active</span>
                    </div>
                }
                else
                {
                    @* Join vendor section *@
                    <div class="border-t border-gray-50 pt-4">
                        <p class="text-sm font-semibold text-gray-700 mb-1">Not yet affiliated with a Vendor</p>
                        <p class="text-xs text-gray-400 mb-3">Ask your Vendor for their referral code and enter it below to join their roster.</p>
                        <div class="flex gap-2">
                            <input @bind="_joinCode" placeholder="Enter vendor code…"
                                   class="flex-1 px-4 py-2.5 rounded-xl border @(_joinError != null ? "border-red-400" : "border-gray-200") text-sm uppercase tracking-widest
                                          focus:outline-none focus:ring-2 focus:ring-indigo-400" />
                            <button @onclick="JoinVendorAsync" disabled="@_joining"
                                    class="px-4 py-2.5 rounded-xl bg-indigo-600 text-white text-sm font-semibold
                                           hover:bg-indigo-700 disabled:opacity-50 transition shadow-sm">
                                @(_joining ? "Joining…" : "Join")
                            </button>
                        </div>
                        @if (_joinError is not null)
                        {
                            <p class="text-xs text-red-500 mt-1">@_joinError</p>
                        }
                        @if (_joinSuccess)
                        {
                            <p class="text-xs text-green-600 mt-1">✅ Successfully joined! Reload to see your vendor.</p>
                        }
                    </div>
                }
            </div>
        }

        @* ── Edit profile form ────────────────────────────────────────────────── *@
        <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6 space-y-5">
            <h3 class="text-sm font-semibold text-gray-700">Edit Profile</h3>

            <div>
                <label class="block text-xs font-medium text-gray-500 mb-1.5 uppercase tracking-wider">Full Name</label>
                <input @bind="_fullName" type="text"
                       class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
            </div>

            <div>
                <label class="block text-xs font-medium text-gray-500 mb-1.5 uppercase tracking-wider">Email (optional)</label>
                <input @bind="_email" type="email"
                       class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
            </div>

            @* ── Extended profile — required when completing a directly-added account,
               optional (but still editable) for everyone else. ── *@
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2 border-t border-gray-50">
                @if (_profile?.Role == "Crew")
                {
                    <div>
                        <label class="block text-xs font-medium text-gray-500 mb-1.5 uppercase tracking-wider">
                            Date of birth @(MustComplete ? "*" : "")
                        </label>
                        <input value="@_dobStr" @oninput="OnDobInput" type="date" max="@_maxDob" min="@_minDob"
                               class="w-full px-4 py-2.5 rounded-xl border @(_touchedDob && !DobOk ? "border-red-400" : "border-gray-200") text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500"
                               @onblur='() => _touchedDob = true' />
                        <p class="text-xs mt-1 @(_dob.HasValue && !DobOk ? "text-red-600" : "text-gray-400")">@DobHint</p>
                    </div>
                }
                <div>
                    <label class="block text-xs font-medium text-gray-500 mb-1.5 uppercase tracking-wider">City @(MustComplete ? "*" : "")</label>
                    <input @bind="_city" type="text" placeholder="Mumbai"
                           class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-medium text-gray-500 mb-1.5 uppercase tracking-wider">State</label>
                    <input @bind="_state" type="text" placeholder="Maharashtra"
                           class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-500 mb-1.5 uppercase tracking-wider">Address</label>
                    <input @bind="_address" type="text" placeholder="Street, area"
                           class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
                </div>
            </div>

            <div>
                <label class="block text-xs font-medium text-gray-500 mb-1.5 uppercase tracking-wider">Bio (optional)</label>
                <textarea @bind="_bio" rows="2" maxlength="2000" placeholder="A short line about you"
                          class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500"></textarea>
            </div>

            @if (_profile?.Role == "Crew")
            {
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-medium text-gray-500 mb-1.5 uppercase tracking-wider">Years of experience</label>
                        <input @bind="_experienceYears" type="number" min="0" max="60" placeholder="3"
                               class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-500 mb-1.5 uppercase tracking-wider">Skills</label>
                        <input @bind="_skills" type="text" placeholder="stage, lighting"
                               class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
                    </div>
                </div>
            }

            @if (_profile?.Role == "Vendor")
            {
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-medium text-gray-500 mb-1.5 uppercase tracking-wider">Contact person</label>
                        <input @bind="_contactPersonName" type="text"
                               class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-500 mb-1.5 uppercase tracking-wider">GST number</label>
                        <input @bind="_gstNumber" type="text"
                               class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-500 mb-1.5 uppercase tracking-wider">Website</label>
                    <input @bind="_website" type="text" placeholder="https://…"
                           class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
                </div>
            }

            @if (MustComplete && !CanSubmitCompletion)
            {
                <div class="bg-amber-50 border border-amber-100 rounded-xl p-3 text-amber-700 text-xs">
                    @(_profile?.Role == "Crew" ? "Date of birth (18+) and City are required before you can continue." : "City is required before you can continue.")
                </div>
            }
            @if (_saveError is not null)
            {
                <div class="bg-red-50 border border-red-100 rounded-xl p-3 text-red-600 text-xs">@_saveError</div>
            }
            @if (_saveSuccess)
            {
                <div class="bg-green-50 border border-green-100 rounded-xl p-3 text-green-600 text-xs">✅ Profile updated successfully.</div>
            }

            <button @onclick="SaveAsync" disabled="@(_saving || (MustComplete && !CanSubmitCompletion))"
                    class="w-full py-2.5 rounded-xl bg-indigo-600 text-white text-sm font-semibold
                           hover:bg-indigo-700 disabled:opacity-50 transition shadow-sm">
                @(_saving ? "Saving…" : (MustComplete ? "Save & Continue" : "Save Changes"))
            </button>
        </div>

        @* ── Info stats ───────────────────────────────────────────────────────── *@
        <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6">
            <div class="grid grid-cols-2 gap-6 text-center">
                <div>
                    <p class="text-xs text-gray-400 mb-1">Permissions</p>
                    <p class="text-2xl font-bold text-indigo-600">@(_profile?.Permissions?.Count ?? 0)</p>
                </div>
                <div>
                    <p class="text-xs text-gray-400 mb-1">Last Login</p>
                    <p class="text-sm font-semibold text-gray-700">@(_profile?.LastLoginAt?.ToLocalTime().ToString("dd MMM HH:mm") ?? "—")</p>
                </div>
            </div>
        </div>
    }

    @if (_toast is not null)
    {
        <div class="fixed bottom-6 right-6 z-50 px-5 py-3 rounded-2xl shadow-xl text-sm font-medium
                    @(_toastErr ? "bg-red-600 text-white" : "bg-green-600 text-white")">
            @_toast
        </div>
    }
</div>

@code {
    private UserProfileDto? _profile;
    private string? _fullName;
    private string? _email;
    private bool    _loading  = true;
    private bool    _saving;
    private string? _loadError;
    private string? _saveError;
    private bool    _saveSuccess;

    // ── Extended profile fields ─────────────────────────────────────────────
    private DateTime? _dob;
    private string  _dobStr = "";
    private bool    _touchedDob;
    private readonly string _maxDob = DateTime.UtcNow.Date.ToString("yyyy-MM-dd");
    private readonly string _minDob = DateTime.UtcNow.Date.AddYears(-ClientValidation.MaximumAge).AddDays(1).ToString("yyyy-MM-dd");
    private string? _city;
    private string? _state;
    private string? _address;
    private string? _bio;
    private string? _skills;
    private int?    _experienceYears;
    private string? _contactPersonName;
    private string? _gstNumber;
    private string? _website;

    /// <summary>True when an Admin/Vendor directly added this account and it's
    /// never had its profile filled in — the form becomes mandatory and Save
    /// is gated on DOB + City until this flips false.</summary>
    private bool MustComplete => _profile is { WasDirectlyAdded: true, ProfileCompleted: false };
    private bool DobOk => _dob.HasValue && ClientValidation.IsAdult(_dob.Value);
    private string DobHint => _dob switch
    {
        null => "Required — must be 18+",
        { } d when ClientValidation.IsAdult(d) => $"Age: {ClientValidation.CalculateAge(d)} — OK ✓",
        { } d when ClientValidation.CalculateAge(d) >= ClientValidation.MaximumAge
            => $"Age: {ClientValidation.CalculateAge(d)} — must be below {ClientValidation.MaximumAge}",
        { } d => $"Age: {ClientValidation.CalculateAge(d)} — must be at least {ClientValidation.MinimumAge}"
    };
    // City is required for every directly-added role; DOB (18+) is additionally
    // required for Crew only — Vendor's DOB never persists server-side
    // (UpdateProfileHandler restricts SetDateOfBirth to Role == Crew).
    private bool CanSubmitCompletion =>
        !string.IsNullOrWhiteSpace(_city) && (_profile?.Role != "Crew" || DobOk);

    private void OnDobInput(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        _dobStr = e.Value?.ToString() ?? "";
        _dob = DateTime.TryParse(_dobStr, out var d) ? d.Date : null;
    }

    // Vendor referral copy
    private bool _copied;
    private string? _inviteMessageTemplate;

    // ── Invite-message composer (Gmail-style toolbar) ─────────────────────
    private ElementReference _templateRef;
    private bool _showFormatMenu;
    private bool _showEmojiMenu;
    private bool _messageCopied;

    private static readonly string[] EmojiChoices =
    {
        "👋", "🎉", "✨", "🙌", "🤝", "💪", "🔥", "⭐",
        "🏆", "🎯", "📣", "📢", "🚀", "✅", "👍", "🙏",
        "❤️", "😊", "😄", "🥳", "😎", "🤩", "💰", "💵",
        "📅", "🕒", "📍", "📌", "🔔", "📱", "💬", "🔗"
    };

    private void ToggleFormatMenu()
    {
        _showFormatMenu = !_showFormatMenu;
        _showEmojiMenu = false;
    }

    private void ToggleEmojiMenu()
    {
        _showEmojiMenu = !_showEmojiMenu;
        _showFormatMenu = false;
    }

