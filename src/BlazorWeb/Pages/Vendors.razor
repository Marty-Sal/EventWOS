@page "/vendors"
@attribute [Authorize(Roles = "Admin,Manager")]
@inject IVendorApiService VendorApi
@inject IJSRuntime JS
@using EventWOS.BlazorWeb.Validation


    @if (_accessDenied)
    {
        <div class="flex flex-col items-center justify-center min-h-[60vh] text-center">
            <div class="text-5xl mb-4">🔒</div>
            <h2 class="text-xl font-bold text-gray-800 mb-2">Access Denied</h2>
            <p class="text-gray-500 text-sm">You don't have permission to view this page.<br/>Contact your Admin to request access.</p>
        </div>
        return;
    }

<PageTitle>Vendors — EventWOS</PageTitle>

<AuthorizeView Roles="Admin,Manager">
    <UserTabsHeader Active="vendor" />
</AuthorizeView>

<div class="space-y-5">

    <!-- Header -->
    <div class="flex items-center justify-between flex-wrap gap-3">
        <div>
            <h2 class="text-lg font-bold text-gray-800">Vendors</h2>
            <p class="text-sm text-gray-500">Manage manpower suppliers.</p>
        </div>
        @if (_canWrite)
        {
            <button @onclick="() => _showCreate = true"
                    class="px-4 py-2 rounded-xl bg-indigo-600 text-white text-sm font-semibold hover:bg-indigo-700 transition shadow">
                + Add Vendor
            </button>
        }
    </div>

    @* Roster stage filter — same convention as the Crew page's chips. *@
    <div class="flex gap-2 flex-wrap">
        @foreach (var tab in _statusTabs)
        {
            <button @onclick="() => SetStatusTab(tab)"
                    class="px-4 py-1.5 rounded-full text-xs font-semibold transition
                           @(_activeStatusTab == tab ? "bg-indigo-600 text-white shadow" : "bg-white text-gray-500 border border-gray-200 hover:border-indigo-300")">
                @tab
            </button>
        }
    </div>

    <div class="flex flex-wrap gap-3 items-center">
        <div class="relative max-w-sm">
            <input @bind="_search" @bind:event="oninput" @onkeyup="OnSearchKeyUp"
                   placeholder="Search vendors…"
                   class="w-64 pl-10 pr-4 py-2.5 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
            <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm">🔍</span>
        </div>

        <select @bind="_sortKey"
                class="px-3 py-2.5 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
            <option value="created_desc">Recently added</option>
            <option value="created_asc">Oldest first</option>
            <option value="name">Name A→Z</option>
            <option value="rating_desc">Rating (high→low)</option>
            <option value="rating_asc">Rating (low→high)</option>
            <option value="crew_desc">Most crew</option>
            <option value="status">Status</option>
        </select>
    </div>

    <!-- Table -->
    @if (_loading)
    {
        <div class="flex justify-center py-16">
            <svg class="animate-spin h-8 w-8 text-indigo-500" viewBox="0 0 24 24" fill="none">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z"/>
            </svg>
        </div>
    }
    else if (_vendors?.Items.Count == 0)
    {
        <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-12 text-center">
            <p class="text-4xl mb-3">🏢</p>
            <p class="text-gray-500 text-sm">No vendors found. Add your first vendor!</p>
        </div>
    }
    else
    {
        <div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden">
            <div class="overflow-x-auto -mx-1 sm:mx-0">
            <table class="min-w-full text-sm">
                <thead class="bg-gray-50 border-b border-gray-100 text-[11px] uppercase tracking-widest text-gray-500">
                    <tr>
                        <th class="text-left px-5 py-3 font-semibold cursor-pointer select-none hover:text-gray-700"
                            @onclick='() => ToggleSort("name", "name_desc")'>
                            Vendor @SortArrow("name", "name_desc")
                        </th>
                        <th class="text-left px-5 py-3 font-semibold">Mobile</th>
                        <th class="text-left px-5 py-3 font-semibold">Referral</th>
                        <th class="text-left px-5 py-3 font-semibold cursor-pointer select-none hover:text-gray-700"
                            @onclick='() => ToggleSort("rating_desc", "rating_asc")'>
                            Rating @SortArrow("rating_desc", "rating_asc")
                        </th>
                        <th class="text-left px-5 py-3 font-semibold cursor-pointer select-none hover:text-gray-700"
                            @onclick='() => ToggleSort("crew_desc", "crew_asc")'>
                            Crew @SortArrow("crew_desc", "crew_asc")
                        </th>
                        <th class="text-left px-5 py-3 font-semibold cursor-pointer select-none hover:text-gray-700"
                            @onclick='() => ToggleSort("status", "status_desc")'>
                            Status @SortArrow("status", "status_desc")
                        </th>
                        <th class="px-5 py-3"></th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-50">
                    @foreach (var v in SortVendors(_vendors!.Items))
                    {
                        <tr class="hover:bg-gray-50 transition-colors">
                            <td class="px-5 py-3.5">
                                <div class="flex items-center gap-3">
                                    <div class="w-9 h-9 rounded-xl bg-amber-100 flex items-center justify-center text-sm font-bold text-amber-700">
                                        @(v.FullName.FirstOrDefault())
                                    </div>
                                    <div>
                                        <p class="font-semibold text-gray-800">@v.FullName</p>
                                        <p class="text-xs text-gray-400">@(v.BusinessName ?? "—")</p>
                                    </div>
                                </div>
                            </td>
                            <td class="px-5 py-3.5 text-gray-600 font-mono text-xs">@v.Mobile</td>
                            <td class="px-5 py-3.5">
                                <span class="font-mono text-xs bg-gray-100 px-2 py-0.5 rounded">@(v.ReferralCode ?? "—")</span>
                            </td>
                            <td class="px-5 py-3.5">
                                @if (v.Rating.HasValue)
                                {
                                    <span class="text-amber-500 font-semibold">★ @v.Rating.Value.ToString("F1")</span>
                                }
                                else { <span class="text-gray-400 text-xs">Unrated</span> }
                            </td>
                            <td class="px-5 py-3.5">
                                <span class="font-semibold text-indigo-600">@v.CrewCount</span>
                            </td>
                            <td class="px-5 py-3.5">
                                <span class="px-2 py-0.5 rounded-full text-xs font-medium @StatusColor(v.Status)">@v.Status</span>
                            </td>
                            <td class="px-5 py-3.5 text-right whitespace-nowrap">
                                <button @onclick="() => OpenDetailsAsync(v)"
                                        class="text-xs text-indigo-600 hover:underline mr-3">🔍 View</button>
                                <button @onclick="() => OpenRate(v)"
                                        class="text-xs text-indigo-600 hover:underline mr-3">Rate</button>
                                <button @onclick="() => ToggleStatus(v)"
                                        class="text-xs @(v.Status == "Active" ? "text-red-500" : "text-green-600") hover:underline">
                                    @(v.Status == "Active" ? "Suspend" : "Activate")
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        </div>

        <!-- Pagination -->
        @if (_vendors!.TotalCount > 20)
        {
            <div class="flex items-center justify-between text-sm text-gray-500">
                <span>@_vendors.TotalCount total vendors</span>
                <div class="flex gap-2">
                    <button @onclick="PrevPage" disabled="@(_page == 1)"
                            class="px-3 py-1.5 rounded-lg border border-gray-200 disabled:opacity-40 hover:bg-gray-50 transition">← Prev</button>
                    <span class="px-3 py-1.5">Page @_page</span>
                    <button @onclick="NextPage" disabled="@(_vendors.TotalCount <= _page * 20)"
                            class="px-3 py-1.5 rounded-lg border border-gray-200 disabled:opacity-40 hover:bg-gray-50 transition">Next →</button>
                </div>
            </div>
        }
    }
</div>

<!-- Create Vendor Modal -->
@if (_showCreate)
{
    <div class="fixed inset-0 bg-black/40 z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md p-6 space-y-4">
            <div class="flex items-center justify-between">
                <h3 class="font-bold text-gray-800">Add Vendor</h3>
                <button @onclick="ResetCreateForm" class="text-gray-400 hover:text-gray-600">✕</button>
            </div>
            <div class="space-y-3">
                <div>
                    <input @ref="_mobileInputRef" value="@_newMobile" @oninput="OnMobileInput" type="tel" inputmode="numeric" maxlength="10"
                           placeholder="Mobile (10 digits)" autocomplete="tel"
                           class="@FieldCss(_touchedMobile && !MobileOk)" @onblur='() => _touchedMobile = true' />
                    @if (_touchedMobile && !MobileOk)
                    {
                        <p class="text-xs text-red-600 mt-1 ml-1">Mobile number must be exactly 10 digits.</p>
                    }
                </div>
                <div>
                    <input @bind="_newName" @bind:event="oninput" placeholder="Full Name"
                           class="@FieldCss(_touchedName && !NameOk)" @onblur='() => _touchedName = true' />
                    @if (_touchedName && !NameOk)
                    {
                        <p class="text-xs text-red-600 mt-1 ml-1">Full name must contain only letters and spaces.</p>
                    }
                </div>
                <input @bind="_newBusiness" placeholder="Business Name (optional)" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
                <div>
                    <input @bind="_newEmail" @bind:event="oninput" type="email" placeholder="Email"
                           class="@FieldCss(_touchedEmail && !EmailOk)" @onblur='() => _touchedEmail = true' />
                    @if (_touchedEmail && !EmailOk)
                    {
                        <p class="text-xs text-red-600 mt-1 ml-1">Enter a valid email address.</p>
                    }
                </div>
            </div>
            @if (_createError is not null)
            {
                <p class="text-xs text-red-600 bg-red-50 rounded-lg px-3 py-2">⚠️ @_createError</p>
            }
            <div class="flex gap-3">
                <button @onclick="CreateVendor" disabled="@(_creating || !MobileOk || !NameOk || !EmailOk)"
                        class="flex-1 py-2.5 rounded-xl bg-indigo-600 text-white text-sm font-semibold hover:bg-indigo-700 disabled:opacity-50 transition">
                    @(_creating ? "Creating…" : "Create Vendor")
                </button>
                <button @onclick="ResetCreateForm"
                        class="px-5 py-2.5 rounded-xl border border-gray-200 text-sm hover:bg-gray-50 transition">Cancel</button>
            </div>
        </div>
    </div>
}

<!-- View Vendor Details Modal -->
@if (_detailsTarget is not null || _detailsLoading)
{
    <div class="fixed inset-0 bg-black/40 flex items-center justify-center z-50 p-4" @onclick="() => { _detailsTarget = null; _detailsLoading = false; }">
        <div class="bg-white rounded-2xl shadow-2xl max-w-lg w-full max-h-[85vh] overflow-y-auto p-6" @onclick:stopPropagation="true">
            @if (_detailsLoading)
            {
                <div class="flex justify-center py-10">
                    <svg class="animate-spin h-8 w-8 text-indigo-500" viewBox="0 0 24 24" fill="none">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z"/>
                    </svg>
                </div>
            }
            else if (_detailsTarget is not null)
            {
                <div class="flex items-start justify-between mb-4">
                    <div class="flex items-center gap-3">
                        <div class="w-11 h-11 rounded-xl bg-amber-100 flex items-center justify-center font-bold text-amber-700 flex-shrink-0">
                            @(_detailsTarget.FullName.FirstOrDefault())
                        </div>
                        <div>
                            <h3 class="text-base font-bold text-gray-900">@_detailsTarget.FullName</h3>
                            <p class="text-xs text-gray-500">Vendor · joined @_detailsTarget.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</p>
                        </div>
                    </div>
                    <button type="button" @onclick="() => _detailsTarget = null" class="text-gray-400 hover:text-gray-600 text-xl leading-none">✕</button>
                </div>

                @if (_detailsTarget.WasDirectlyAdded)
                {
                    <div class="mb-4">
                        @if (_detailsTarget.ProfileCompleted)
                        {
                            <span class="inline-flex items-center gap-1 text-xs font-medium px-2 py-1 rounded-full bg-green-100 text-green-700">Profile completed</span>
                        }
                        else
                        {
                            <span class="inline-flex items-center gap-1 text-xs font-medium px-2 py-1 rounded-full bg-amber-100 text-amber-700">Invited — awaiting profile completion</span>
                        }
                    </div>
                }

                <div class="grid grid-cols-2 gap-3 text-sm">
                    <DetailField Label="Mobile" Value="@_detailsTarget.Mobile" />
                    <DetailField Label="Email" Value="@_detailsTarget.Email" />
                    <DetailField Label="Business name" Value="@_detailsTarget.BusinessName" />
                    <DetailField Label="Contact person" Value="@_detailsTarget.ContactPersonName" />
                    <DetailField Label="Referral code" Value="@_detailsTarget.ReferralCode" />
                    <DetailField Label="Status" Value="@_detailsTarget.Status" />
                    <DetailField Label="Rating" Value="@(_detailsTarget.Rating.HasValue ? $"★ {_detailsTarget.Rating.Value:F1}" : "Unrated")" />
                    <DetailField Label="Crew count" Value="@_detailsTarget.CrewCount.ToString()" />
                    <DetailField Label="Events completed" Value="@_detailsTarget.EventsCompleted.ToString()" />
                    <DetailField Label="GST number" Value="@_detailsTarget.GstNumber" />
                    <DetailField Label="Website" Value="@_detailsTarget.Website" />
                    <DetailField Label="City" Value="@_detailsTarget.City" />
                    <DetailField Label="State" Value="@_detailsTarget.State" />
                    <DetailField Label="Date of birth" Value="@(_detailsTarget.DateOfBirth?.ToString("dd MMM yyyy"))" />
                    <DetailField Label="Address" Value="@_detailsTarget.Address" Span="2" />
                    <DetailField Label="About" Value="@_detailsTarget.Bio" Span="2" />
                </div>

                <FileDocumentList Files="@_detailsTarget.Files" />

                <div class="mt-5 flex justify-end gap-2">
                    <button type="button" @onclick="() => _detailsTarget = null" class="px-3 py-1.5 text-xs rounded-lg bg-gray-100 text-gray-700 hover:bg-gray-200">Close</button>
                </div>
            }
        </div>
    </div>
}

<!-- Rate Vendor Modal -->
@if (_rateTarget is not null)
{
    <div class="fixed inset-0 bg-black/40 z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-2xl w-full max-w-sm p-6 space-y-4">
            <h3 class="font-bold text-gray-800">Rate @_rateTarget.FullName</h3>
            <div class="flex gap-2 items-center">
                <input @bind="_newRating" type="number" min="0" max="5" step="0.1"
                       class="flex-1 px-4 py-2.5 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-amber-400" />
                <span class="text-amber-500 text-xl">★</span>
            </div>
            <div class="flex gap-3">
                <button @onclick="SubmitRating"
                        class="flex-1 py-2.5 rounded-xl bg-amber-500 text-white text-sm font-semibold hover:bg-amber-600 transition">
                    Submit Rating
                </button>
                <button @onclick="() => _rateTarget = null"
                        class="px-5 py-2.5 rounded-xl border border-gray-200 text-sm hover:bg-gray-50 transition">Cancel</button>
            </div>
        </div>
    </div>
}

@code {

    private bool _accessDenied;
    private bool _canWrite;
    private PagedVendorResult? _vendors;
    private bool _loading = true;
    private int  _page    = 1;
    private string? _search;
    private string  _sortKey = "created_desc";
    private System.Timers.Timer? _debounce;

    // ── Status filter chips — same convention as Crew's roster tabs. ─────
    private readonly string[] _statusTabs = { "All", "Active Vendors", "Suspended Vendors", "Rejected Vendors" };
    private string _activeStatusTab = "All";
    private string? StatusForTab(string tab) => tab switch
    {
        "Active Vendors"    => "Active",
        "Suspended Vendors" => "Suspended",
        "Rejected Vendors"  => "Rejected",
        _                   => null
    };

    private async Task SetStatusTab(string tab)
    {
        if (_activeStatusTab == tab) return;
        _activeStatusTab = tab;
        _page = 1;
        await LoadAsync();
    }

    // Client-side, like Crew's SortCrew — only reorders whatever page is
    // currently loaded (search/status filters are the server-side ones).
    private IEnumerable<VendorListItemDto> SortVendors(IEnumerable<VendorListItemDto> items) => _sortKey switch
    {
        "created_asc" => items.OrderBy(v => v.CreatedAt),
        "name"        => items.OrderBy(v => v.FullName, StringComparer.OrdinalIgnoreCase),
        "name_desc"   => items.OrderByDescending(v => v.FullName, StringComparer.OrdinalIgnoreCase),
        "rating_desc" => items.OrderByDescending(v => v.Rating ?? -1),
        "rating_asc"  => items.OrderBy(v => v.Rating ?? decimal.MaxValue),
        "crew_desc"   => items.OrderByDescending(v => v.CrewCount),
        "crew_asc"    => items.OrderBy(v => v.CrewCount),
        "status"      => items.OrderBy(v => v.Status),
        "status_desc" => items.OrderByDescending(v => v.Status),
        _             => items.OrderByDescending(v => v.CreatedAt)
    };

    /// <summary>Click-to-sort column headers, same convention as Crew.razor's
    /// ToggleSort/SortArrow — flips between a header's asc/desc key and
    /// keeps the "sort by" dropdown in sync with whichever header was
    /// last clicked (they both just read/write _sortKey).</summary>
    private void ToggleSort(string keyA, string keyB) => _sortKey = _sortKey == keyA ? keyB : keyA;

    private string SortArrow(string ascKey, string descKey) =>
        _sortKey == ascKey ? "▲" : _sortKey == descKey ? "▼" : "";

    private bool _showCreate;
    private bool _creating;
    private string? _createError;
    private string _newMobile   = string.Empty;
    private string _newName     = string.Empty;
    private string? _newBusiness;
    private string? _newEmail;

    // ── Add Vendor form validation (mirrors ClientValidation — see RegisterCrew.razor) ──
    private const string FieldCssOk    = "w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500";
    private const string FieldCssError = "w-full px-4 py-2.5 rounded-xl border border-red-400 text-sm focus:outline-none focus:ring-2 focus:ring-red-400";
    private static string FieldCss(bool hasError) => hasError ? FieldCssError : FieldCssOk;

    private ElementReference _mobileInputRef;
    private bool _touchedMobile, _touchedName, _touchedEmail;

    private bool MobileOk => ClientValidation.IsValidMobile(_newMobile);
    private bool NameOk   => ClientValidation.IsValidFullName(_newName);
    private bool EmailOk  => ClientValidation.IsValidEmail(_newEmail);

    private VendorListItemDto? _rateTarget;

    // ── View details modal (fetches the richer VendorDetailDto — Email +
    // AvatarUrl aren't on the list DTO — reusing the GetVendorAsync/{id}
    // endpoint that already existed but had no caller yet) ──
    private VendorDetailDto? _detailsTarget;
    private bool _detailsLoading;

    private async Task OpenDetailsAsync(VendorListItemDto v)
    {
        _detailsLoading = true; _detailsTarget = null;
        _detailsTarget = await VendorApi.GetVendorAsync(v.Id);
        _detailsLoading = false;
    }
    private decimal _newRating = 5.0m;

    protected override async Task OnInitializedAsync()
    {
        // ── Permission gate ──────────────────────────────────────────────────────
        _accessDenied = !await PermGuard.CanAsync("vendors:read");
        if (_accessDenied) { StateHasChanged(); return; }
        _canWrite = await PermGuard.CanAsync("vendors:write");
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _vendors = await VendorApi.GetVendorsAsync(_page, _search, status: StatusForTab(_activeStatusTab));
        _loading = false;
    }

    private void OnSearchKeyUp(KeyboardEventArgs _)
    {
        _debounce?.Dispose();
        _debounce = new System.Timers.Timer(400);
        _debounce.Elapsed += async (_, _) =>
        {
            _page = 1;
            await InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); });
            _debounce?.Dispose();
        };
        _debounce.AutoReset = false;
        _debounce.Start();
    }

    private async Task PrevPage() { _page--; await LoadAsync(); }
    private async Task NextPage() { _page++; await LoadAsync(); }

    private async Task OnMobileInput(ChangeEventArgs e)
    {
        _newMobile = ClientValidation.FilterDigits(e.Value?.ToString(), 10);
        await JS.InvokeVoidAsync("eventwosForms.setInputValue", _mobileInputRef, _newMobile);
    }

    private void ResetCreateForm()
    {
        _showCreate  = false;
        _createError = null;
        _newMobile   = string.Empty;
        _newName     = string.Empty;
        _newBusiness = null;
        _newEmail    = null;
        _touchedMobile = _touchedName = _touchedEmail = false;
    }

    private async Task CreateVendor()
    {
        _touchedMobile = _touchedName = _touchedEmail = true;
        if (!MobileOk || !NameOk || !EmailOk) return;
        _creating = true; _createError = null;
        var (ok, err) = await VendorApi.CreateVendorAsync(_newMobile, _newName, _newBusiness, _newEmail);
        if (ok)
        {
            ResetCreateForm();
            await LoadAsync();
        }
        else { _createError = err; }
        _creating = false;
    }

    private void OpenRate(VendorListItemDto v) { _rateTarget = v; _newRating = v.Rating ?? 5.0m; }

    private async Task SubmitRating()
    {
        if (_rateTarget is null) return;
        await VendorApi.RateVendorAsync(_rateTarget.Id, _newRating);
        _rateTarget = null;
        await LoadAsync();
    }

    private async Task ToggleStatus(VendorListItemDto v)
    {
        var newStatus = v.Status == "Active" ? "suspended" : "active";
        await VendorApi.ChangeVendorStatusAsync(v.Id, newStatus);
        await LoadAsync();
    }

    private static string StatusColor(string status) => status switch
    {
        "Active"      => "bg-green-50 text-green-700 border border-green-100",
        "Suspended"   => "bg-amber-50 text-amber-700 border border-amber-100",
        "Deactivated" => "bg-red-50 text-red-600 border border-red-100",
        _             => "bg-gray-100 text-gray-500"
    };
}
