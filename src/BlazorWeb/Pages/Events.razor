    // ── Form Model ─────────────────────────────────────────────────────────────
    private class EventForm
    {
        public string    Title       { get; set; } = "";
        public string?   Description { get; set; }
        public string    Venue       { get; set; } = "";
        public string?   Address     { get; set; }

        // ── Venue picker (state -> searchable venue dropdown) ──────────────
        // VenueId is what actually gets sent to the API; Venue/Address above
        // are populated as display copy the moment a venue is picked (the
        // server re-derives them from VenueId anyway, but keeping them in
        // sync client-side means the read-only summary always matches).
        public Guid?             VenueId       { get; set; }
        public string?           VenueState    { get; set; }
        public string            VenueSearch   { get; set; } = "";
        public bool              VenueDropOpen { get; set; }
        // Nullable so a fresh form renders empty ("mm/dd/yyyy --:--") instead
        // of the DateTime.MinValue placeholder (01/01/0001) that a non-nullable
        // DateTime would surface after Blazor's initial render. OpenCreateModal
        // seeds sensible defaults; SaveEvent gates on non-null before submit.
        public DateTime? StartAt     { get; set; }
        public DateTime? EndAt       { get; set; }
        public int       MaxCrew     { get; set; } = 1;

        // Phase C step 4 (create-mode only): list of shift drafts. Each
        // row maps 1:1 to a CreateEventShiftRequest on save. MaxCrew is
        // derived from SUM(Shifts.CrewCount) at submit-time. We don't
        // include a default row here — OpenCreateModal seeds it once
        // (after the catalog is loaded) so we know which scope to default to.
        public List<ShiftDraft> Shifts { get; set; } = new();
    }

    /// <summary>
    /// One row in the multi-shift editor. ScopeOfWorkId is required on
    /// save; StartAt and EndAt are both nullable — null means "use the
    /// event's start" and "run until the event wraps" respectively, and
    /// they're mapped straight through to the API. CrewCount has min=1
    /// from the input element but the save-time guard also floors it to 1.
    /// </summary>
    public sealed class ShiftDraft : IShiftVendorDraft
    {
        public Guid      ScopeOfWorkId { get; set; }
        public int       CrewCount     { get; set; } = 1;

        // ── Optional vendor assignment right at shift-creation time ────────
        // When Vendor is set, the WHOLE shift (CrewCount seats) gets granted
        // to this one vendor server-side as soon as the shift is created —
        // no separate trip to the "Vendor Quotas" section needed. Leaving it
        // blank keeps the old behaviour exactly (unassigned shift). The
        // search/results/drop-open fields are transient UI state, kept on
        // the row itself (not shared page-level state) so multiple shift
        // rows can each search independently without clobbering each other.
        public VendorListItemDto?      Vendor         { get; set; }
        public string                  VendorSearch   { get; set; } = "";
        public List<VendorListItemDto> VendorResults  { get; set; } = new();
        public bool                    VendorDropOpen { get; set; }

        // Phase D step 2: optional per-shift start. Null = use event StartAt.
        // Stored as nullable local-time DateTime; converted to UTC at save.
        public DateTime? StartAt       { get; set; }
        // Optional per-shift end. Null = run until the event wraps. Kept
        // nullable so the datetime-local input renders empty ("mm/dd/yyyy
        // --:--") on a fresh row instead of the DateTime.MinValue placeholder
        // (01/01/0001) that a non-nullable DateTime would surface.
        public DateTime? EndAt         { get; set; }
    }
}
