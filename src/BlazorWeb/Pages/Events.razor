    // so the default can never silently arm an unenforceable fence.
    private bool _attendanceVerifyQrCode           = false;
    private bool _attendanceVerifyFaceRecognition  = false;
    private bool _attendanceVerifyLocation         = true;

    /// <summary>
    /// Chosen radius. 150 m default: comfortably outside GPS jitter, tight
