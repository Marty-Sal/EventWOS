    // ── Init ───────────────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        // ── Permission gate ──────────────────────────────────────────────────────
        _accessDenied = !await PermGuard.CanAsync("events:read");
        if (_accessDenied) { StateHasChanged(); return; }
        _canWrite = await PermGuard.CanAsync("events:write");

        var authState = await Auth.GetAuthenticationStateAsync();
        _role = authState.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value
             ?? authState.User.FindFirst("role")?.Value ?? "";

        if (_role is "Admin" or "Manager")
            await LoadEvents();
        else if (_role == "Vendor")
            await LoadVendorAssignments();
        else
            await LoadMyAssignments(); // Crew

        // Live refresh whenever any assignment in the system moves.
        Hub.AssignmentInviteReceived  += OnAssignmentMoved;
        Hub.CrewAcceptedReceived      += OnAssignmentMoved;
        Hub.CrewDeclinedReceived      += OnAssignmentMoved;
        Hub.VendorApprovedReceived    += OnAssignmentMoved;
        Hub.VendorRejectedReceived    += OnAssignmentMoved;
        Hub.ManagerApprovedReceived   += OnAssignmentMoved;
        Hub.ManagerRejectedReceived   += OnAssignmentMoved;
        try { await Hub.StartAsync(); } catch { }
    }

    public async ValueTask DisposeAsync()
    {
        Hub.AssignmentInviteReceived  -= OnAssignmentMoved;
        Hub.CrewAcceptedReceived      -= OnAssignmentMoved;
        Hub.CrewDeclinedReceived      -= OnAssignmentMoved;
        Hub.VendorApprovedReceived    -= OnAssignmentMoved;
        Hub.VendorRejectedReceived    -= OnAssignmentMoved;
        Hub.ManagerApprovedReceived   -= OnAssignmentMoved;
        Hub.ManagerRejectedReceived   -= OnAssignmentMoved;
        await ValueTask.CompletedTask;
    }

    private void OnAssignmentMoved(NotificationPayload payload)
    {
        _ = InvokeAsync(async () =>
        {
            if (_role is "Admin" or "Manager")      await LoadEvents();
            else if (_role == "Vendor")             await LoadVendorAssignments();
            else                                    await LoadMyAssignments();
            StateHasChanged();
        });
    }

    // ── Admin/Manager ──────────────────────────────────────────────────────────
    private async Task LoadEvents()
    {
        _loading = true;
        _events  = await EventApi.GetEventsAsync(_page, _search, _statusFilter);
        if (_events is not null)
            _totalPages = (int)Math.Ceiling((double)_events.TotalCount / 20);
        _loading = false;
    }

    private async Task OnStatusFilterChanged(string? value)
    {
        _statusFilter = value;
        _page = 1;
        await LoadEvents();
    }

    private async Task OnSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") { _page = 1; await LoadEvents(); }
    }

    private async Task PrevPage() { if (_page > 1) { _page--; await LoadEvents(); } }
    private async Task NextPage() { if (_page < _totalPages) { _page++; await LoadEvents(); } }

    private async Task OpenDetailPanel(EventListItemDto ev)
    {
        _loadingViewEventId = ev.Id;
        try
        {
        _selectedEvent = await EventApi.GetEventAsync(ev.Id);
        if (_selectedEvent is null) { _error = "Could not load event details."; return; }
        _loadingAssignments = true;
        _assignments = await EventApi.GetAssignmentsAsync(ev.Id);
        _loadingAssignments = false;
        if (_selectedEvent.Status is "InProgress" or "Completed")
            _attendance = await EventApi.GetAttendanceSummaryAsync(ev.Id);

        // Phase C step 5: load shifts + allocations for this event so the
        // Vendor Quotas section can render. Errors are silent (UI shows
        // "no shifts" naturally) — section gates on _selectedEventShifts.
        _allocationsByShift.Clear();
        _allocSectionOpen = false;
        _allocError       = null;
        _selectedEventShifts = await EventApi.GetEventShiftsAsync(ev.Id);
        if (_selectedEventShifts is not null)
        {
            foreach (var sh in _selectedEventShifts)
            {
                var rows = await AllocApi.GetForShiftAsync(sh.Id);
                _allocationsByShift[sh.Id] = rows ?? Array.Empty<VendorAllocationDto>();
            }
        }

        // Auto-expand the first vendor group so the drawer doesn't open
        // looking empty when there are assignments. Subsequent groups stay
        // collapsed — keeps the panel tidy for events fanned across many
        // vendors.
        _expandedVendorGroups.Clear();
        if (_assignments is not null && _assignments.Items.Count > 0)
        {
            var first = GroupAssignmentsByVendor(_assignments.Items).FirstOrDefault();
            if (first is not null) _expandedVendorGroups.Add(first.Key);
        }
        }
        finally { _loadingViewEventId = null; }
    }

    private void CloseDetailPanel()
    {
        _selectedEvent = null;
        _assignments = null;
        _attendance = null;
        _expandedVendorGroups.Clear();
        // Phase C step 5: tear down allocation drawer state too.
        _selectedEventShifts = null;
        _allocationsByShift.Clear();
        _allocSectionOpen = false;
        _allocError = null;
        _allocEditingId = null;
        CloseAllocCreate();
    }

    // ── Phase C step 5: handlers ───────────────────────────────────────
    private void ToggleAllocSection() => _allocSectionOpen = !_allocSectionOpen;

    private void StartAllocEdit(VendorAllocationDto row)
    {
        _allocEditingId = row.Id;
        _allocEditQuota = row.Quota;
        _allocError     = null;
    }

    private void CancelAllocEdit()
    {
        _allocEditingId = null;
        _allocError = null;
    }

    private async Task SaveAllocEdit(VendorAllocationDto row)
    {
        if (_allocEditQuota < row.CurrentlyAssigned)
        {
            _allocError = $"Can't shrink below {row.CurrentlyAssigned} — that many crew are already assigned under this vendor.";
            return;
        }
        var (ok, err, updated) = await AllocApi.UpdateAsync(row.Id, _allocEditQuota);
        if (!ok) { _allocError = err; return; }
        await ReloadShiftAllocations(row.ShiftId);
        _allocEditingId = null;
        _allocError     = null;
    }

    private async Task ArchiveAlloc(VendorAllocationDto row)
    {
        if (row.CurrentlyAssigned > 0)
        {
            _allocError = $"Can't remove — {row.CurrentlyAssigned} crew are still assigned under this vendor on this shift.";
            return;
        }
        var (ok, err) = await AllocApi.ArchiveAsync(row.Id);
        if (!ok) { _allocError = err; return; }
        await ReloadShiftAllocations(row.ShiftId);
        _allocError = null;
    }

    private void OpenAllocCreate(Guid shiftId)
    {
        var sh = _selectedEventShifts?.FirstOrDefault(x => x.Id == shiftId);
        if (sh is null) return;
        var totalQ = _allocationsByShift.GetValueOrDefault(shiftId)
                        ?.Where(r => !r.IsArchived).Sum(r => r.Quota) ?? 0;
        _allocCreateShiftId  = shiftId;
        _allocCreateMaxQuota = Math.Max(1, sh.CrewCount - totalQ);
        _allocCreateQuota    = Math.Min(1, _allocCreateMaxQuota);
        if (_allocCreateQuota < 1) _allocCreateQuota = 1;
        _allocCreateVendor   = null;
        _allocVendorSearch   = string.Empty;
        _allocVendorResults  = new();
        _allocCreateError    = null;
    }

    private void CloseAllocCreate()
    {
        _allocCreateShiftId = null;
        _allocCreateVendor  = null;
        _allocCreateError   = null;
        _allocVendorResults = new();
        _allocVendorSearch  = string.Empty;
        _allocSearchCts?.Cancel();
        _allocSearchCts     = null;
    }

    private async Task OnAllocVendorSearch(ChangeEventArgs e)
    {
        _allocVendorSearch = e.Value?.ToString() ?? string.Empty;
        if (_allocVendorSearch.Length < 1)
        {
            _allocVendorResults = new();
            return;
        }
        // Cancel previous in-flight search so we don't race results.
        _allocSearchCts?.Cancel();
        _allocSearchCts = new System.Threading.CancellationTokenSource();
        var token = _allocSearchCts.Token;
        try
        {
            var page = await VendorApi.GetVendorsAsync(1, _allocVendorSearch, ct: token);
            if (token.IsCancellationRequested) return;
            _allocVendorResults = page?.Items?.Take(8).ToList() ?? new();
        }
        catch (OperationCanceledException) { /* superseded; ignore */ }
    }

    private void SelectAllocVendor(VendorListItemDto v)
    {
        _allocCreateVendor  = v;
        _allocVendorResults = new();
        _allocVendorSearch  = string.Empty;
    }

    private async Task SubmitAllocCreate()
    {
        if (_allocCreateShiftId is null || _allocCreateVendor is null) return;
        if (_allocCreateQuota < 1) { _allocCreateError = "Quota must be at least 1."; return; }
        if (_allocCreateQuota > _allocCreateMaxQuota)
        {
            _allocCreateError = $"Only {_allocCreateMaxQuota} seats left on this shift.";
            return;
        }
        _allocCreateSubmitting = true;
        _allocCreateError      = null;
        try
        {
            var (ok, err, _) = await AllocApi.CreateAsync(
                _allocCreateShiftId.Value, _allocCreateVendor.Id, _allocCreateQuota);
            if (!ok) { _allocCreateError = err; return; }
            var shiftId = _allocCreateShiftId.Value;
            await ReloadShiftAllocations(shiftId);
            CloseAllocCreate();
        }
        finally
        {
            _allocCreateSubmitting = false;
        }
    }

    private async Task ReloadShiftAllocations(Guid shiftId)
    {
        var rows = await AllocApi.GetForShiftAsync(shiftId);
        _allocationsByShift[shiftId] = rows ?? Array.Empty<VendorAllocationDto>();
    }

    private async Task OpenCreateModal()
    {
        _editingEvent = null;
        // Seed reasonable defaults: tomorrow, 9am → 1pm local. Users can override.
        var seedDate  = DateTime.Now.Date.AddDays(1);
        var seedStart = seedDate.AddHours(9);
        var seedEnd   = seedDate.AddHours(13);
        _form = new EventForm { StartAt = seedStart, EndAt = seedEnd };
        _formError = null;
        _manualVenueEntry = false;
        _showAddVenueForm = false;
        _showEventModal = true;
        await EnsureScopeCatalogLoaded();
        // Phase C step 4: seed exactly ONE default shift row pointing at the
        // first scope. If the catalog is empty the editor renders a helpful
        // "create one first" banner instead.
        if (_form.Shifts.Count == 0 && _scopeCatalog.Count > 0)
            _form.Shifts.Add(new ShiftDraft { ScopeOfWorkId = _scopeCatalog[0].Id, CrewCount = 1 });
    }

    private void ToggleActionsMenu(EventListItemDto ev, MouseEventArgs e)
    {
        if (_openActionsMenuEvent?.Id == ev.Id)
        {
            _openActionsMenuEvent = null;
            return;
        }
        _openActionsMenuEvent = ev;
        // Anchor to the click point; shift left so a menu opened from the
        // rightmost column (where ⋮ lives) doesn't run off the viewport.
        _actionsMenuX = Math.Max(8, e.ClientX - 160);
        _actionsMenuY = e.ClientY + 8;
    }

    /// <summary>
    /// Duplicates an event into a fresh Create form: same description,
    /// dates, shifts (scope/crew count/times) and each shift's vendor
    /// quotas — but Title and Venue are cleared since those are almost
    /// always different for a re-run of the same show. The admin reviews
    /// everything in the normal Create Event modal and picks a new title
    /// + venue before saving; nothing is written until they hit Create.
    /// </summary>
    private async Task ReplicateEvent(EventListItemDto? ev)
    {
        _openActionsMenuEvent = null;
        if (ev is null) return;

        var detail = await EventApi.GetEventAsync(ev.Id);
        if (detail is null) { _error = "Could not load that event to replicate."; return; }

        var origShifts = await EventApi.GetEventShiftsAsync(ev.Id) ?? new List<EventShiftDto>();

        // Pull each shift's live (non-archived) vendor allocations up front
        // so they can be reapplied to the new shifts right after creation —
        // see SaveEvent's post-create block.
        var allocations = new List<IReadOnlyList<VendorAllocationDto>>();
        foreach (var sh in origShifts)
        {
            var rows = await AllocApi.GetForShiftAsync(sh.Id) ?? Array.Empty<VendorAllocationDto>();
            allocations.Add(rows.Where(a => !a.IsArchived).ToList());
        }

        await EnsureScopeCatalogLoaded();

        _editingEvent      = null;   // Create mode, not Edit — this becomes a new event
        _formError         = null;
        _manualVenueEntry  = false;
        _showAddVenueForm  = false;

        _form = new EventForm
        {
            Title       = "",                                  // cleared — pick a new title
            Description = detail.Description,
            Venue       = "",                                   // cleared — pick a new venue
            Address     = null,
            VenueId     = null,
            StartAt     = detail.StartAt.ToLocalTime(),
            EndAt       = detail.EndAt.ToLocalTime(),
            Shifts      = origShifts.Select(sh => new ShiftDraft
            {
                ScopeOfWorkId = sh.ScopeOfWorkId,
                CrewCount     = sh.CrewCount,
                StartAt       = sh.StartAt.ToLocalTime(),
                EndAt         = sh.EndAt?.ToLocalTime(),
            }).ToList(),
        };

        _pendingReplicationAllocations = allocations;
        _replicatingFromTitle          = detail.Title;
        _showEventModal = true;
    }

    /// <summary>Append a fresh shift row, defaulting to the first scope.</summary>
    private void AddShiftRow()
    {
        if (_scopeCatalog.Count == 0) return;
        _form.Shifts.Add(new ShiftDraft { ScopeOfWorkId = _scopeCatalog[0].Id, CrewCount = 1 });
    }

    /// <summary>Remove a shift row by index. Last-row delete is guarded in markup.</summary>
    private void RemoveShiftRow(int index)
    {
        if (index < 0 || index >= _form.Shifts.Count) return;
        if (_form.Shifts.Count <= 1) return;  // belt-and-braces; UI hides the button too
        _form.Shifts.RemoveAt(index);
    }

    /// <summary>
    /// Phase B: lazy-load the active scope-of-work catalog. We pull a big
    /// page (200) instead of paginating — the catalog is admin-curated and
    /// realistically &lt; 50 rows. If that ever stops being true, swap for
    /// a typeahead.
    /// </summary>
    private async Task EnsureScopeCatalogLoaded()
    {
        if (_scopeCatalog.Count > 0) return;
        try
        {
            var resp = await Http.GetFromJsonAsync<ScopeApiEnvelope>(
                "/api/v1/scope-of-work?page=1&pageSize=200&includeArchived=false");
            if (resp?.Data?.Items is not null)
                _scopeCatalog = resp.Data.Items
                    .Select(x => new ScopePickItem(x.Id, x.Name))
                    .OrderBy(x => x.Name)
                    .ToList();
        }
        catch
        {
            // Picker degrades gracefully — modal shows the "no scopes yet"
            // empty state and the user goes to /admin/scope-of-work.
            _scopeCatalog = new();
        }
    }

    private sealed record ScopeApiEnvelope(ScopeApiData? Data);
    private sealed record ScopeApiData(List<ScopePickItem> Items);

    // ── Venue picker handlers ────────────────────────────────────────────
    // State-first, then a searchable venue dropdown within that state (per
    // owner request). Venues are catalog data (Settings not built yet —
    // this modal doubles as the entry point via "+ Add new venue").
    private async Task LoadVenuesForStateAsync(string state)
    {
        try
        {
            var url = $"/api/v1/venues?state={Uri.EscapeDataString(state)}&includeArchived=false&page=1&pageSize=200";
            var resp = await Http.GetFromJsonAsync<VenueListEnvelope>(url);
            _venuesForState = resp?.Data?.Items
                ?.Select(v => new VenuePickItem(v.Id, v.Name, v.AddressLine1, v.City, v.State))
                .OrderBy(v => v.Name)
                .ToList() ?? new();
        }
        catch { _venuesForState = new(); }
        _venueSearchResults = _venuesForState;
    }

    private async Task OnVenueStateSelected(string? state)
    {
        _form.VenueState = string.IsNullOrWhiteSpace(state) ? null : state;
        _form.VenueId    = null;
        _form.Venue      = "";
        _form.Address    = null;
        _form.VenueSearch   = "";
        _form.VenueDropOpen = false;
        _venuesForState = new();
        _venueSearchResults = new();
        if (_form.VenueState is not null)
            await LoadVenuesForStateAsync(_form.VenueState);
    }

    private void OnVenueSearchInput(ChangeEventArgs e)
    {
        _form.VenueSearch = e.Value?.ToString() ?? "";
        var q = _form.VenueSearch.Trim();
        _venueSearchResults = q.Length == 0
            ? _venuesForState
            : _venuesForState.Where(v =>
                v.Name.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                v.City.Contains(q, StringComparison.OrdinalIgnoreCase)).ToList();
        _form.VenueDropOpen = true;
    }

    private async Task SelectVenue(VenuePickItem v)
    {
        _form.VenueId       = v.Id;
        _form.Venue         = v.Name;
        _form.Address       = string.IsNullOrWhiteSpace(v.City) ? v.AddressLine1 : $"{v.AddressLine1}, {v.City}";
        _form.VenueSearch    = "";
        _form.VenueDropOpen  = false;

        // Pull coordinates now so the geofence preview can render straight away.
        await LoadPickedVenueCoordsAsync();
    }

    private void ClearPickedVenue()
    {
        _form.VenueId = null;
        _form.Venue   = "";
        _form.Address = null;

        // Stale coordinates would keep the geofence panel showing a map for a
        // venue that is no longer selected.
        _pickedVenueCoords = null;
    }

    private void SwitchToVenuePicker()
    {
        // Legacy-event escape hatch: lets an old free-text venue be
        // migrated to a real catalog pick without leaving the modal.
        _manualVenueEntry = false;
    }

    private void ToggleAddVenueForm()
    {
        _showAddVenueForm = !_showAddVenueForm;
        _addVenueError = null;
        if (_showAddVenueForm)
            _addVenueForm = new AddVenueForm { State = _form.VenueState ?? "" };
    }

    private async Task SubmitAddVenue()
    {
        if (string.IsNullOrWhiteSpace(_addVenueForm.Name) ||
            string.IsNullOrWhiteSpace(_addVenueForm.AddressLine1) ||
            string.IsNullOrWhiteSpace(_addVenueForm.City) ||
            string.IsNullOrWhiteSpace(_addVenueForm.State))
        {
            _addVenueError = "Name, address, city and state are required.";
            return;
        }

        _addVenueSaving = true;
        _addVenueError  = null;
        try
        {
            var payload = new
            {
                name = _addVenueForm.Name.Trim(),
                addressLine1 = _addVenueForm.AddressLine1.Trim(),
                city = _addVenueForm.City.Trim(),
                state = _addVenueForm.State.Trim(),
                latitude = _addVenueForm.Latitude,
                longitude = _addVenueForm.Longitude
            };
            var resp = await Http.PostAsJsonAsync("/api/v1/venues", payload);
            if (resp.IsSuccessStatusCode)
            {
                var body = await resp.Content.ReadFromJsonAsync<VenueSingleEnvelope>();
                var created = body?.Data;
                if (created is not null)
                {
                    // Select the newly created venue's state, load venues for
                    // it, and auto-pick the new one.
                    _form.VenueState = created.State ?? _addVenueForm.State;
                    await LoadVenuesForStateAsync(_form.VenueState!);
                    SelectVenue(new VenuePickItem(created.Id, created.Name, created.AddressLine1, created.City, created.State));
                    _showAddVenueForm = false;
                }
            }
            else
            {
                var body = await resp.Content.ReadFromJsonAsync<ApiErrorEnvelope>();
                _addVenueError = body?.Errors?.FirstOrDefault() ?? body?.Message ?? "Could not save venue.";
            }
        }
        catch (Exception ex) { _addVenueError = ex.Message; }
        finally { _addVenueSaving = false; }
    }

