    /// default in CreateEventHandler.
    /// </summary>
    private int _geoFenceRadiusMeters = 150;

    /// <summary>
    /// Coordinates of the currently picked venue, loaded when it's selected so
    /// the map preview and the "no coordinates" warning don't need a lookup on
    /// every render. Null = venue has none (or none picked).
    /// </summary>
    private (decimal Latitude, decimal Longitude)? _pickedVenueCoords;

    /// <summary>
    /// True only when the fence is genuinely armable: ticked, a catalog venue is
    /// picked, and that venue has coordinates. The submit path uses this rather
    /// than the checkbox alone — the server would reject an unenforceable fence
    /// anyway, and failing the whole event creation over a verification toggle
    /// would be a poor trade.
    /// </summary>
    private bool GeoFenceIsArmable
        => _attendanceVerifyLocation && _form.VenueId is not null && _pickedVenueCoords is not null;

    private void OnGeoFenceToggled(ChangeEventArgs e)
    {
        _attendanceVerifyLocation = e.Value is true;
    }

    /// <summary>
    /// Fetch the picked venue's coordinates. Called on venue selection rather
    /// than during render so the map preview appears immediately after a pick.
    /// </summary>
    private async Task LoadPickedVenueCoordsAsync()
    {
        _pickedVenueCoords = null;
        if (_form.VenueId is not { } venueId) return;

        try
        {
            var r = await Http.GetFromJsonAsync<VenueCoordsResult>(
                $"/api/v1/venues/{venueId}");

            if (r?.Data?.Latitude is { } lat && r.Data.Longitude is { } lng)
                _pickedVenueCoords = ((decimal)lat, (decimal)lng);
        }
        catch
        {
            // Non-fatal: without coordinates the UI shows the "add them in
            // Settings" hint, which is the correct state anyway.
            _pickedVenueCoords = null;
        }
    }

