    /// <summary>
    /// Formats a shift's duration for the "≈ X hours" hint shown under the
    /// start/end pickers wherever a shift's time window is edited. Returns
    /// null when there's nothing sensible to show yet (end not entered) —
    /// callers fall back to an "open-ended" hint in that case instead.
    /// </summary>
    private static string? FormatShiftDuration(DateTime? start, DateTime? end)
    {
        if (start is null || end is null) return null;
        var span = end.Value - start.Value;
        if (span <= TimeSpan.Zero) return null;   // invalid range — the separate validation message covers this
        var totalMinutes = (int)Math.Round(span.TotalMinutes);
        var hours   = totalMinutes / 60;
        var minutes = totalMinutes % 60;
        if (minutes == 0)
            return $"{hours} hr{(hours == 1 ? "" : "s")}";
        if (hours == 0)
            return $"{minutes} min";
        return $"{hours}h {minutes}m";
    }

