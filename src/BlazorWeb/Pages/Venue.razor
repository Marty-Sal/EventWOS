@page "/admin/settings/venue"
@attribute [Authorize(Roles = "Admin,Manager")]
@inject HttpClient Http
@using System.Net.Http
@using System.Net.Http.Json
@using EventWOS.BlazorWeb.Components
@using EventWOS.BlazorWeb.Services
@inject ILocationApiService LocationApi
@inject IIndianStatesApiService StatesApi

<PageTitle>Settings — Venue — EventWOS</PageTitle>

@*
    Settings → Venue. Admin-managed catalog of venues so an Event just
    picks a saved location instead of re-entering it every time. Fields
    mirror what geocoding needs later (structured address + lat/lng) even
    though nothing auto-geocodes yet — memory: Venue is master data, Event
    just references it.
*@

<SettingsTabs ActiveTab="venue" />

@if (_accessDenied)
{
    <div class="flex flex-col items-center justify-center min-h-[60vh] text-center">
        <div class="text-5xl mb-4">🔒</div>
        <h2 class="text-xl font-bold text-gray-800 mb-2">Access Denied</h2>
        <p class="text-gray-500 text-sm">You need <strong>venues:read</strong> permission.</p>
    </div>
    return;
}

<div class="space-y-6">
    <div class="flex items-center justify-between">
        <p class="text-sm text-gray-500 mt-0.5">
            Catalog of venues used when creating events. Pick a saved venue instead of typing an address each time.
        </p>
        @if (_canWrite)
        {
            <button @onclick="OpenCreateModal"
                    class="px-4 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold transition shrink-0">
                ➕ New Venue
            </button>
        }
    </div>

    <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-4 flex flex-wrap items-center gap-3">
        <input @bind="_search" @bind:event="oninput" @onkeyup="OnSearchKey"
               placeholder="Search by name, city…"
               class="px-3 py-2 rounded-xl border border-gray-200 text-sm flex-1 min-w-[200px] focus:outline-none focus:ring-2 focus:ring-indigo-300" />
        <label class="flex items-center gap-2 text-sm text-gray-600 cursor-pointer select-none">
            <input type="checkbox" @bind="_includeArchived" @bind:after="LoadAsync"
                   class="rounded border-gray-300 text-indigo-600 focus:ring-indigo-500" />
            Show archived
        </label>
    </div>

    @if (_loading)
    {
        <div class="flex items-center justify-center py-20">
            <svg class="animate-spin h-8 w-8 text-indigo-500" viewBox="0 0 24 24" fill="none">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z" />
            </svg>
        </div>
    }
    else if (_error is not null)
    {
        <div class="bg-red-50 border border-red-100 rounded-2xl p-5 text-red-600 text-sm">@_error</div>
    }
    else if (_items.Count == 0)
    {
        <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-10 text-center">
            <div class="text-4xl mb-2">📍</div>
            <p class="text-sm text-gray-500">
                No venues yet.
                @if (_canWrite) { <span>Create your first one to use it when creating events.</span> }
            </p>
        </div>
    }
    else
    {
        <div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden">
            <div class="overflow-x-auto -mx-1 sm:mx-0">
            <table class="min-w-full text-sm">
                <thead class="bg-gray-50 border-b border-gray-100 text-xs uppercase tracking-wider text-gray-500">
                    <tr>
                        <th class="px-5 py-3 text-left">Name</th>
                        <th class="px-5 py-3 text-left">Address</th>
                        <th class="px-5 py-3 text-left">City / State</th>
                        <th class="px-5 py-3 text-left">Lat / Lng</th>
                        <th class="px-5 py-3 text-left">Status</th>
                        <th class="px-5 py-3 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    @foreach (var v in _items)
                    {
                        <tr class="hover:bg-gray-50 transition">
                            <td class="px-5 py-3 font-semibold text-gray-800">@v.Name</td>
                            <td class="px-5 py-3 text-gray-500">
                                @(string.IsNullOrWhiteSpace(v.ShortAddress) ? v.AddressLine1 : v.ShortAddress)
                            </td>
                            <td class="px-5 py-3 text-gray-500">@v.City@(string.IsNullOrEmpty(v.State) ? "" : $", {v.State}")</td>
                            <td class="px-5 py-3 text-gray-400 text-xs">
                                @(v.Latitude is null ? "—" : $"{v.Latitude:F5}, {v.Longitude:F5}")
                            </td>
                            <td class="px-5 py-3">
                                @if (v.IsArchived)
                                {
                                    <span class="text-xs px-2.5 py-1 rounded-full font-semibold bg-gray-100 text-gray-500">Archived</span>
                                }
                                else
                                {
                                    <span class="text-xs px-2.5 py-1 rounded-full font-semibold bg-emerald-50 text-emerald-700">Active</span>
                                }
                            </td>
                            <td class="px-5 py-3 text-right">
                                @if (_canWrite)
                                {
                                    @if (v.IsArchived)
                                    {
                                        <button @onclick="() => RestoreAsync(v)"
                                                class="text-xs px-3 py-1 rounded-lg bg-emerald-50 hover:bg-emerald-100 text-emerald-700 font-semibold">
                                            ↻ Restore
                                        </button>
                                    }
                                    else
                                    {
                                        <button @onclick="() => OpenEditModal(v)"
                                                class="text-xs px-3 py-1 rounded-lg bg-indigo-50 hover:bg-indigo-100 text-indigo-700 font-semibold mr-2">
                                            Edit
                                        </button>
                                        <button @onclick="() => ArchiveAsync(v)"
                                                class="text-xs px-3 py-1 rounded-lg bg-rose-50 hover:bg-rose-100 text-rose-700 font-semibold">
                                            Archive
                                        </button>
                                    }
                                }
                                else
                                {
                                    <span class="text-xs text-gray-300 italic">read-only</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        </div>

        @if (_totalPages > 1)
        {
            <div class="flex justify-center gap-2 pt-2">
                <button @onclick="PrevPage" disabled="@(_page == 1)"
                        class="px-3 py-1.5 text-sm rounded-lg border border-gray-200 disabled:opacity-40 hover:bg-gray-50">← Prev</button>
                <span class="px-3 py-1.5 text-sm text-gray-500">Page @_page of @_totalPages</span>
                <button @onclick="NextPage" disabled="@(_page >= _totalPages)"
                        class="px-3 py-1.5 text-sm rounded-lg border border-gray-200 disabled:opacity-40 hover:bg-gray-50">Next →</button>
            </div>
        }
    }
</div>

@* ── Create / Edit modal ──────────────────────────────────────────────────── *@
@if (_modalOpen)
{
    <div class="fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4" @onclick="CloseModal">
        <div class="bg-white rounded-2xl shadow-2xl w-full max-w-lg p-6 space-y-4 max-h-[90vh] overflow-y-auto" @onclick:stopPropagation>
            <div class="flex items-center justify-between">
                <h3 class="text-base font-bold text-gray-800">@(_editing is null ? "New Venue" : "Edit Venue")</h3>
                <button @onclick="CloseModal" class="text-gray-400 hover:text-gray-600 text-xl">✕</button>
            </div>

            <div class="space-y-3">
                <div>
                    <label class="text-xs text-gray-500 mb-1 block">Name *</label>
                    <input @bind="_form.Name" maxlength="120"
                           placeholder="e.g. Grand Convention Hall"
                           class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
                </div>
                <div>
                    <label class="text-xs text-gray-500 mb-1 block">Address line 1 *</label>
                    <input @bind="_form.AddressLine1" maxlength="200"
                           class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
                </div>
                <div>
                    <label class="text-xs text-gray-500 mb-1 block">Address line 2 (optional)</label>
                    <input @bind="_form.AddressLine2" maxlength="200"
                           class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="text-xs text-gray-500 mb-1 block">City *</label>
                        <input @bind="_form.City" maxlength="200"
                               class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
                    </div>
                    <div>
                        <label class="text-xs text-gray-500 mb-1 block">State *</label>
                        <StateSelect @bind-Value="_form.State" />
                    </div>
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="text-xs text-gray-500 mb-1 block">Postal code</label>
                        <input @bind="_form.PostalCode" maxlength="20"
                               class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
                    </div>
                    <div>
                        <label class="text-xs text-gray-500 mb-1 block">Country</label>
                        <input @bind="_form.Country" maxlength="100"
                               class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
                    </div>
                </div>
                @* ── Location ────────────────────────────────────────────
                   Search fills the address fields AND the coordinates in one
                   step, then the pin can be nudged to the exact gate/entrance.
                   Raw lat/lng inputs are kept below as a fallback: search can't
                   find every venue, and an admin with survey coordinates
                   shouldn't be forced through a map. *@
                <div class="pt-2 border-t border-gray-100 space-y-3">
                    <div class="flex items-center justify-between">
                        <h4 class="text-sm font-semibold text-gray-700">Location</h4>
                        @if (_form.Latitude is not null)
                        {
                            <span class="text-[11px] px-2 py-0.5 rounded-full bg-green-50 text-green-700 border border-green-200">
                                Coordinates set
                            </span>
                        }
                        else
                        {
                            @* Say why it matters — an admin who skips this can't
                               enable location verification on their events. *@
                            <span class="text-[11px] px-2 py-0.5 rounded-full bg-amber-50 text-amber-700 border border-amber-200"
                                  title="Events at this venue can't use location verification until coordinates are saved.">
                                No coordinates yet
                            </span>
                        }
                    </div>

                    <LocationSearchBox Label="Search for this venue"
                                       Placeholder="e.g. Millennium Business Park, Navi Mumbai"
                                       OnSelected="ApplySearchResult" />

                    <LocationMap @ref="_map"
                                 Latitude="ToDecimal(_form.Latitude)"
                                 Longitude="ToDecimal(_form.Longitude)"
                                 Draggable="true"
                                 Height="240px"
                                 OnPositionChanged="OnPinMoved" />

                    <details class="text-xs">
                        <summary class="cursor-pointer text-gray-500 hover:text-gray-700">
                            Enter coordinates manually
                        </summary>
                        <div class="grid grid-cols-2 gap-3 mt-2">
                            <div>
                                <label class="text-xs text-gray-500 mb-1 block">Latitude</label>
                                @* bind:after -- typing here used to move the pin (LocationMap reacts to
                                   the parameter change) but never reverse-geocoded, because that call only
                                   ever lived in OnPinMoved, which JS drag/click reaches and this input
                                   never did. Firing the same handler on blur/Enter (@bind's default
                                   "change" event, not every keystroke) closes that gap without adding a
                                   second, diverging code path. *@
                                <input @bind="_form.Latitude" @bind:after="OnManualCoordinateChangedAsync"
                                       type="number" step="any"
                                       class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
                            </div>
                            <div>
                                <label class="text-xs text-gray-500 mb-1 block">Longitude</label>
                                <input @bind="_form.Longitude" @bind:after="OnManualCoordinateChangedAsync"
                                       type="number" step="any"
                                       class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
                            </div>
                        </div>
                    </details>
                </div>
                <div>
                    <label class="text-xs text-gray-500 mb-1 block">Notes (optional)</label>
                    <textarea @bind="_form.Notes" maxlength="1000" rows="2"
                              class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500"></textarea>
                </div>
            </div>

            @if (_formError is not null)
            {
                <p class="text-sm text-red-600">⚠️ @_formError</p>
            }

            <div class="flex gap-3">
                <button @onclick="CloseModal"
                        class="flex-1 py-2.5 rounded-xl border border-gray-200 text-sm text-gray-600 hover:bg-gray-50 transition">
                    Cancel
                </button>
                <button @onclick="SaveAsync" disabled="@_saving"
                        class="flex-1 py-2.5 rounded-xl bg-indigo-600 text-white text-sm font-semibold hover:bg-indigo-700 transition disabled:opacity-60">
                    @(_saving ? "Saving…" : (_editing is null ? "Create" : "Save"))
                </button>
            </div>
        </div>
    </div>
}

@* Toasts *@
@if (_success is not null)
{
    <div class="fixed bottom-5 right-5 bg-green-600 text-white text-sm px-5 py-3 rounded-xl shadow-lg z-50">
        ✅ @_success <button @onclick="() => _success = null" class="ml-3 font-bold">✕</button>
    </div>
}
@if (_pageError is not null)
{
    <div class="fixed bottom-5 right-5 bg-red-600 text-white text-sm px-5 py-3 rounded-xl shadow-lg z-50">
        ⚠️ @_pageError <button @onclick="() => _pageError = null" class="ml-3 font-bold">✕</button>
    </div>
}

@code {
    private bool _accessDenied;
    private bool _canWrite;
    private bool _loading = true;
    private string? _error;
    private string? _success;
    private string? _pageError;

    private string? _search;
    private bool    _includeArchived;
    private int     _page = 1;
    private int     _totalPages = 1;
    private List<VenueDto> _items = new();

    private bool   _modalOpen;
    private bool   _saving;
    private string? _formError;
    private VenueDto? _editing;
    private VenueForm _form = new();

    private static readonly System.Text.Json.JsonSerializerOptions JsonOpts =
        new() { PropertyNameCaseInsensitive = true };

    protected override async Task OnInitializedAsync()
    {
        _accessDenied = !await PermGuard.CanAsync("venues:read");
        if (_accessDenied) { _loading = false; StateHasChanged(); return; }
        _canWrite = await PermGuard.CanAsync("venues:write");
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error   = null;
        try
        {
            var url = $"/api/v1/venues?page={_page}&pageSize=50&includeArchived={_includeArchived.ToString().ToLower()}";
            if (!string.IsNullOrWhiteSpace(_search))
                url += $"&search={Uri.EscapeDataString(_search)}";

            var resp = await Http.GetFromJsonAsync<ApiEnvelope<PagedShape<VenueDto>>>(url, JsonOpts);
            if (resp?.Data is null) { _error = "Failed to load."; return; }
            _items      = resp.Data.Items?.ToList() ?? new();
            _totalPages = resp.Data.TotalPages == 0 ? 1 : resp.Data.TotalPages;
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }

    private async Task OnSearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") { _page = 1; await LoadAsync(); }
    }

    private async Task PrevPage() { if (_page > 1) { _page--; await LoadAsync(); } }
    private async Task NextPage() { if (_page < _totalPages) { _page++; await LoadAsync(); } }

    private void OpenCreateModal()
    {
        _editing   = null;
        _form      = new VenueForm();
        _formError = null;
        _modalOpen = true;
    }

    private void OpenEditModal(VenueDto v)
    {
        _editing = v;
        _form = new VenueForm
        {
            Name = v.Name, AddressLine1 = v.AddressLine1, AddressLine2 = v.AddressLine2,
            ShortAddress = v.ShortAddress,
            City = v.City, State = v.State, PostalCode = v.PostalCode, Country = v.Country,
            Latitude = v.Latitude, Longitude = v.Longitude, Notes = v.Notes
        };
        _formError = null;
        _modalOpen = true;
    }

    private void CloseModal() { _modalOpen = false; _formError = null; }

    // ── Location picker wiring ──────────────────────────────────────────────

    private LocationMap? _map;

    /// <summary>
    /// Apply a search suggestion to the form.
    ///
    /// Address fields are only FILLED IN, never overwritten once the admin has
    /// typed something: the geocoder is often wrong about unit numbers and hall
    /// names, and silently replacing hand-entered text would destroy the more
    /// accurate value. Coordinates are the exception — they're the whole point of
    /// picking a suggestion, so they always take the new value.
    /// </summary>
    /// <summary>
    /// Apply a chosen suggestion. All field rules live in VenueLocationMapper —
    /// this method only fetches the canonical state list and pushes the result
    /// into the form, so a future edit here cannot quietly change (or delete) the
    /// coordinate assignment the way it did once already.
    /// </summary>
    private async Task ApplySearchResult(LocationSuggestion s)
    {
        _form.Apply(VenueLocationMapper.ApplySuggestion(_form.ToLocationFields(), s, await CanonicalStatesAsync()));

        // Clear any stale "required field" error the pick may have just resolved.
        _formError = null;
        StateHasChanged();
    }

    /// <summary>
    /// The admin typed/edited a coordinate box directly instead of using the map
    /// or search. Fires on blur/Enter (bind:after, not every keystroke) once both
    /// boxes hold a value, and then reuses OnPinMoved so manual entry gets the
    /// exact same reverse-geocode-and-fill behaviour as dragging the pin -- one
    /// code path instead of a second one that silently drifts from it.
    ///
    /// Guarded against re-firing for the same pair: blurring Latitude then
    /// Longitude for a single edit would otherwise geocode twice, once with a
    /// stale partner value.
    /// </summary>
    private double? _lastManualLat, _lastManualLng;

    private async Task OnManualCoordinateChangedAsync()
    {
        var lat = _form.Latitude;
        var lng = _form.Longitude;
        if (lat is null || lng is null) return;
        if (lat == _lastManualLat && lng == _lastManualLng) return;

        _lastManualLat = lat;
        _lastManualLng = lng;

        await OnPinMoved(((decimal)lat.Value, (decimal)lng.Value));
    }

    /// <summary>
    /// The admin dragged the pin. The dragged coordinates are applied immediately
    /// and unconditionally; the address is refreshed afterwards and is allowed to
    /// fail silently, because a missing label must never block the save.
    /// </summary>
    private async Task OnPinMoved((decimal Latitude, decimal Longitude) pos)
    {
        var lat = (double)pos.Latitude;
        var lng = (double)pos.Longitude;

        // Coordinates land before the network calls so the form reflects the drag
        // instantly rather than after a round trip.
        _form.Apply(VenueLocationMapper.ApplyReverseGeocode(
            _form.ToLocationFields(), detail: null, lat, lng, Array.Empty<string>()));
        StateHasChanged();

        var detail = await LocationApi.ReverseGeocodeAsync(pos.Latitude, pos.Longitude);
        if (detail is null) return;

        _form.Apply(VenueLocationMapper.ApplyReverseGeocode(
            _form.ToLocationFields(), detail, lat, lng, await CanonicalStatesAsync()));
        StateHasChanged();
    }

    /// <summary>
    /// The exact option list StateSelect renders. Empty on failure, which makes
    /// the mapper leave State blank rather than guess an unselectable value.
    /// </summary>
    private async Task<IReadOnlyList<string>> CanonicalStatesAsync()
    {
        try
        {
            var states = await StatesApi.GetStatesAsync();
            return states.Select(x => x.Name).ToList();
        }
        catch
        {
            return Array.Empty<string>();
        }
    }

    /// <summary>double? -> decimal? for the map component, which speaks decimal.</summary>
    private static decimal? ToDecimal(double? v)
        => v is null ? null : Math.Round((decimal)v.Value, 6);



    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_form.Name) || string.IsNullOrWhiteSpace(_form.AddressLine1) ||
            string.IsNullOrWhiteSpace(_form.City)  || string.IsNullOrWhiteSpace(_form.State))
        {
            _formError = "Name, address, city and state are required.";
            return;
        }
        _saving = true;
        _formError = null;
        try
        {
            HttpResponseMessage resp = _editing is null
                ? await Http.PostAsJsonAsync("/api/v1/venues", _form)
                : await Http.PutAsJsonAsync($"/api/v1/venues/{_editing.Id}", _form);

            if (resp.IsSuccessStatusCode)
            {
                _success = _editing is null ? "Created." : "Updated.";
                _modalOpen = false;
                await LoadAsync();
            }
            else
            {
                var body = await resp.Content.ReadFromJsonAsync<ApiEnvelope<object>>();
                _formError = body?.Errors?.FirstOrDefault() ?? body?.Message ?? "Save failed.";
            }
        }
        catch (Exception ex) { _formError = ex.Message; }
        finally { _saving = false; }
    }

    private async Task ArchiveAsync(VenueDto v)
    {
        try
        {
            var resp = await Http.DeleteAsync($"/api/v1/venues/{v.Id}");
            if (resp.IsSuccessStatusCode) { _success = "Archived."; await LoadAsync(); }
            else
            {
                var body = await resp.Content.ReadFromJsonAsync<ApiEnvelope<object>>();
                _pageError = body?.Errors?.FirstOrDefault() ?? body?.Message ?? "Archive failed.";
            }
        }
        catch (Exception ex) { _pageError = ex.Message; }
    }

    private async Task RestoreAsync(VenueDto v)
    {
        try
        {
            var resp = await Http.PostAsync($"/api/v1/venues/{v.Id}/restore", null);
            if (resp.IsSuccessStatusCode) { _success = "Restored."; await LoadAsync(); }
            else
            {
                var body = await resp.Content.ReadFromJsonAsync<ApiEnvelope<object>>();
                _pageError = body?.Errors?.FirstOrDefault() ?? body?.Message ?? "Restore failed.";
            }
        }
        catch (Exception ex) { _pageError = ex.Message; }
    }

    public sealed class VenueForm
    {
        public string  Name         { get; set; } = "";
        public string  AddressLine1 { get; set; } = "";
        public string? AddressLine2 { get; set; }
        /// <summary>Compact display label captured from search — see Venue.ShortAddress.</summary>
        public string? ShortAddress { get; set; }
        public string  City         { get; set; } = "";
        public string? State        { get; set; }
        public string? PostalCode   { get; set; }
        public string? Country      { get; set; }
        public double? Latitude     { get; set; }
        public double? Longitude    { get; set; }
        public string? Notes        { get; set; }

        /// <summary>Snapshot the location fields for the pure mapper.</summary>
        public VenueLocationFields ToLocationFields() => new(
            Name, AddressLine1, ShortAddress, City, State, PostalCode, Country, Latitude, Longitude);

        /// <summary>Write a mapper result back. Notes and the id are untouched.</summary>
        public void Apply(VenueLocationFields f)
        {
            Name         = f.Name ?? "";
            AddressLine1 = f.AddressLine1 ?? "";
            ShortAddress = f.ShortAddress;
            City         = f.City ?? "";
            State        = f.State;
            PostalCode   = f.PostalCode;
            Country      = f.Country;
            Latitude     = f.Latitude;
            Longitude    = f.Longitude;
        }
    }

    public sealed record VenueDto(
        Guid Id, string Name, string AddressLine1, string? AddressLine2, string? ShortAddress, string City,
        string? State, string? PostalCode, string? Country, double? Latitude, double? Longitude,
        string? Notes, bool IsArchived, DateTime CreatedAt, DateTime? UpdatedAt);

    private sealed class ApiEnvelope<T>
    {
        public bool          Success { get; set; }
        public T?            Data    { get; set; }
        public string?       Message { get; set; }
        public List<string>? Errors  { get; set; }
    }

    private sealed class PagedShape<T>
    {
        public List<T> Items      { get; set; } = new();
        public int     TotalCount { get; set; }
        public int     PageNumber { get; set; }
        public int     PageSize   { get; set; }
        public int     TotalPages { get; set; }
    }
}
